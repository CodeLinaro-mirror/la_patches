diff --git a/service/java/com/android/server/wifi/WifiStateMachine.java b/service/java/com/android/server/wifi/WifiStateMachine.java
index d2f8f29..f723db5 100644
--- a/service/java/com/android/server/wifi/WifiStateMachine.java
+++ b/service/java/com/android/server/wifi/WifiStateMachine.java
@@ -3384,9 +3384,13 @@ public class WifiStateMachine extends StateMachine {
                     try {
                         level = Integer.parseInt(line.substring(LEVEL_STR.length()));
                         /* some implementations avoid negative values by adding 256
+                         * some other report signal level in positive percent [0,100]
                          * so we need to adjust for that here.
                          */
-                        if (level > 0) level -= 256;
+                        //Assuming this code not handling super HW capable to report RSSI = -156
+                        if (level > 100) level -= 256;
+                        else if(level > 0) level = -101 + level;//so 100% = -1 20% = -81
+
                     } catch(NumberFormatException e) {
                         level = 0;
                     }
