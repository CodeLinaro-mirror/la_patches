     }
+
+    private void logMsgWithVisibilityDump(WifiConfiguration config, String msg) {
+        logDbg(msg
+                + config.autoJoinStatus
+                + " key " + config.configKey(true)
+                + " rssi=(" + config.visibility.rssi24
+                + "," + config.visibility.rssi5
+                + "," + config.visibility.rssi60
+                + ") num=(" + config.visibility.num24
+                + "," + config.visibility.num5
+                + "," + config.visibility.num60 + ")");
+    }
 }
 
