 .../android/server/NetworkManagementService.java   | 28 ++++++++++++++++++++--
 wifi/java/android/net/wifi/WifiConfiguration.java  | 25 +++++++++++++++++--
 2 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/services/core/java/com/android/server/NetworkManagementService.java b/services/core/java/com/android/server/NetworkManagementService.java
index e7df19a..0b37dc8 100644
--- a/services/core/java/com/android/server/NetworkManagementService.java
+++ b/services/core/java/com/android/server/NetworkManagementService.java
@@ -1408,8 +1408,10 @@ public class NetworkManagementService extends INetworkManagementService.Stub
                 mConnector.execute("softap", "set", wlanIface);
             } else {
                 mConnector.execute("softap", "set", wlanIface, wifiConfig.SSID,
-                                   "broadcast", "6", getSecurityType(wifiConfig),
-                                   new SensitiveArg(wifiConfig.preSharedKey));
+                                   "broadcast", getChannel(wifiConfig),
+                                   getSecurityType(wifiConfig),
+                                   new SensitiveArg(wifiConfig.preSharedKey),
+                                   getWifiHwMode(wifiConfig));
             }
             mConnector.execute("softap", "startap");
         } catch (NativeDaemonConnectorException e) {
@@ -1417,6 +1419,28 @@ public class NetworkManagementService extends INetworkManagementService.Stub
         }
     }
 
+    private static String getChannel(WifiConfiguration wifiConfig){
+        //TODO: Use AP channel and band from WifiConfiguration (once WifiConfiguration supports this)
+        switch (wifiConfig.hw_mode) {
+        case ad:
+            return "2";
+        default:
+            return "6";
+        }
+    }
+
+    private static String getWifiHwMode(WifiConfiguration wifiConfig){
+        switch (wifiConfig.hw_mode) {
+        case a:
+            return "a";
+        case ad:
+            return "ad";
+        case g:
+        default:
+            return "g";
+        }
+    }
+
     private static String getSecurityType(WifiConfiguration wifiConfig) {
         switch (wifiConfig.getAuthType()) {
             case KeyMgmt.WPA_PSK:
