+static DBusHandlerResult oppclient_agent_error_handler(DBusConnection *conn,
+                                                       DBusMessage *msg) {
+    LOGI(__FUNCTION__);
+    
+    const char *transfer, *message;
+    JNIEnv *env = event_loop_nat->env;
+    
+    if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_OBJECT_PATH, &transfer,
+                               DBUS_TYPE_STRING, &message,
+                               DBUS_TYPE_INVALID)) {
+        LOGE("%s: Invalid arguments for %s() method", __FUNCTION__, 
+            OBEXD_DBUS_CLIENT_AGENT_ERROR);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    LOGE("... transfer = %s\n... message = %s", transfer, message);
+
+    env->CallVoidMethod(nat->me, method_onObexTransferComplete,
+                        env->NewStringUTF(transfer),
+                        JNI_FALSE, 
+                        env->NewStringUTF(message));
+
+    DBusMessage *reply = dbus_message_new_method_return(msg);
+    
+    if (reply) {
+        dbus_message_append_args(reply, DBUS_TYPE_INVALID);
+
+        dbus_connection_send(nat->conn, reply, NULL);
+
+        dbus_message_unref(reply);
+
+        return DBUS_HANDLER_RESULT_HANDLED;
