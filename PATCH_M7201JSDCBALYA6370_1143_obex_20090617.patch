+                  currentRxTotal += total ;
+                  currentRxDone += done;
+               }
+            }//if fileInfo
+         }//while iter.hasNext
+      }//synchronized (mReceivingContactsList)
+      if ( (currentTxTotal + currentRxTotal)>0) {
