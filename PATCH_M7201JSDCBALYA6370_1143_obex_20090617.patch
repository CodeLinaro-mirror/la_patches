+#ifdef HAVE_BLUETOOTH
+static void onSendFilesComplete(DBusMessage *msg, void *user) {
+    LOGI(__FUNCTION__);
+
+    char *c_address = (char *)user;
+    DBusError err;
+    jboolean is_error = JNI_FALSE;
+    JNIEnv *env = event_loop_nat->env;
+    
+    dbus_error_init(&err);
