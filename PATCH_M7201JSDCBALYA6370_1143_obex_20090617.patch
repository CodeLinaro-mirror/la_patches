+static DBusHandlerResult oppserver_agent_authorize_handler(DBusConnection *conn,
+                                                           DBusMessage *msg) {
+    LOGI(__FUNCTION__);
+    
+    const char *transfer, *address, *filename, *type;
+    int32_t length, time;
+    JNIEnv *env = event_loop_nat->env;
+    
+    if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_OBJECT_PATH, &transfer,
+                               DBUS_TYPE_STRING, &address,
+                               DBUS_TYPE_STRING, &filename,
+                               DBUS_TYPE_STRING, &type,
+                               DBUS_TYPE_INT32, &length,
+                               DBUS_TYPE_INT32, &time,
+                               DBUS_TYPE_INVALID)) {
+        LOGE("%s: Invalid arguments for %s() method", __FUNCTION__, 
+             OBEXD_DBUS_SRV_AGENT_AUTHORIZE);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    LOGE("... transfer = %s\n... address = %s\n... filename = %s\n... type ="
+         "%s\n... length = %d\n... time = %d\n", transfer, address, filename,
+         type, length, time);
+
+    dbus_message_ref(msg);
+
+    env->CallBooleanMethod(nat->me, method_onObexAuthorize,
+                           env->NewStringUTF(transfer),
+                           env->NewStringUTF(address),
+                           env->NewStringUTF(filename),
+                           env->NewStringUTF(type),
+                           (jint) length,
+                           (jint) msg);
+
+    return DBUS_HANDLER_RESULT_HANDLED;
+}
+
+static DBusHandlerResult oppserver_agent_cancel_handler(DBusConnection *conn,
+                                                        DBusMessage *msg) {
+    LOGI(__FUNCTION__);
+    
+    JNIEnv *env = event_loop_nat->env;
+    
+    if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_INVALID)) {
+        LOGE("%s: Invalid arguments for %s() method", __FUNCTION__, 
+             OBEXD_DBUS_SRV_AGENT_CANCEL);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    const char *path;
+
+    path = dbus_message_get_path(msg);
+
+    if (!path){
+        LOGE("Function %s:%d Unable to get path", 
+                 __FUNCTION__, __LINE__);
+    } else {
+        LOGE("... Authorize for transfer %s cancelled by OBEX", path);
+
+        env->CallBooleanMethod(nat->me, method_onObexAuthorizeCancel,
+                               env->NewStringUTF(path));
+
+        return DBUS_HANDLER_RESULT_HANDLED;
+    }
+
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
