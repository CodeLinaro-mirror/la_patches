+            mSessionDb.updateSessionByAddress(address, session);
+        }
+        
+        // Send callback
+        try {
+            ((IBluetoothFtpCallback)dbItem.mCallback).onCreateSessionComplete(isError);
+        } catch (RemoteException e) {
+            Log.e(TAG, "", e);
+        }
+    }
