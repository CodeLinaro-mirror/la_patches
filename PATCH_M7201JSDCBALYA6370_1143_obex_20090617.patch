+DBusHandlerResult opp_event_filter(DBusMessage *msg, JNIEnv *env) {
+    LOGI(__FUNCTION__);
+    
+    DBusError err;
+
+    if (!nat) {
+        LOGE("... skipping %s\n", __FUNCTION__);
+        LOGE("... ignored\n");
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    dbus_error_init(&err);
+
+    if (dbus_message_get_type(msg) != DBUS_MESSAGE_TYPE_SIGNAL) {
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    DBusHandlerResult result = DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+
+    if (dbus_message_is_signal(msg, OBEXD_DBUS_SRV_MGR_IFC,
+                               OBEXD_DBUS_SRV_MGR_SGNL_OPP_SESS_CREATED)) {
+        char *c_session;
+        if (dbus_message_get_args(msg, &err,
+                                  DBUS_TYPE_OBJECT_PATH, &c_session,
+                                  DBUS_TYPE_INVALID)) {
+            LOGE("... Session Created = %s", c_session);
+        } else {
+            LOG_AND_FREE_DBUS_ERROR_WITH_MSG(&err, msg);
+        }
+
+        result = DBUS_HANDLER_RESULT_HANDLED;
+     } else if (dbus_message_is_signal(msg, OBEXD_DBUS_SRV_MGR_IFC,
+                                       OBEXD_DBUS_SRV_MGR_SGNL_OPP_SESS_REMOVED)) {
+        char *c_session;
+        if (dbus_message_get_args(msg, &err,
+                                  DBUS_TYPE_OBJECT_PATH, &c_session,
+                                  DBUS_TYPE_INVALID)) {
+            LOGE("... Session Removed = %s", c_session);
+        } else {
+            LOG_AND_FREE_DBUS_ERROR_WITH_MSG(&err, msg);
+        }
+
+        result = DBUS_HANDLER_RESULT_HANDLED;
+    } else if (dbus_message_is_signal(msg, OBEXD_DBUS_SRV_MGR_IFC,
+                                      OBEXD_DBUS_SRV_MGR_SGNL_OPP_TRANS_STARTED)) {
+        
+        char *c_transfer;
+        
+        if (dbus_message_get_args(msg, &err,
+                                  DBUS_TYPE_OBJECT_PATH, &c_transfer,
+                                  DBUS_TYPE_INVALID)) {
+            LOGE("... Transfer Started = %s", c_transfer);
+
+            /* Do nothing for now, not used by UI.
+            size_t len = 0;
+            char *rule = NULL;
+
+            len = sizeof(OBEXD_DBUS_SRV_TRANS_SGNL_RULE) +  strlen(c_transfer) 
+                    + sizeof("'");
+
+            rule = (char *) calloc(len, sizeof(*rule));
+
+            if (!rule) {
+                LOGE("Function %s:%d Out of Memory", __FUNCTION__, __LINE__);
+            } else {
+                memcpy(rule, OBEXD_DBUS_SRV_TRANS_SGNL_RULE, 
+                       sizeof(OBEXD_DBUS_SRV_TRANS_SGNL_RULE));
+
+                char *pos = NULL;
+                
+                pos = strstr((const char *) rule, "InsertHere");
+
+                if (!pos) {
+                    LOGE("Function %s:%d Transfer Rule string is incorrect: %s", 
+                         __FUNCTION__, __LINE__, rule);
+                } else {
+                    strncpy(pos, c_transfer, len - pos + 1);
+                    strlcat(rule, "'", len);
+                   
+                    dbus_bus_add_match(nat->conn, rule, &err);
+                    
+                    if (dbus_error_is_set(&err)) {
+                        LOG_AND_FREE_DBUS_ERROR(&err);
+                    }
+                }
+            } */
+        } else {
+            LOG_AND_FREE_DBUS_ERROR_WITH_MSG(&err, msg);
+        }
+
+        result = DBUS_HANDLER_RESULT_HANDLED;
+    } else if (dbus_message_is_signal(msg, OBEXD_DBUS_SRV_MGR_IFC,
+                                      OBEXD_DBUS_SRV_MGR_SGNL_OPP_TRANS_COMPLETED)) {
+        char *c_transfer;
+        
+        if (dbus_message_get_args(msg, &err,
+                                  DBUS_TYPE_OBJECT_PATH, &c_transfer,
+                                  DBUS_TYPE_INVALID)) {
+            LOGE("... Transfer Completed = %s", c_transfer);
+
+            env->CallVoidMethod(nat->me, method_onObexTransferComplete, 
+                                env->NewStringUTF(c_transfer),
+                                JNI_TRUE, NULL);
+        } else {
+            LOG_AND_FREE_DBUS_ERROR_WITH_MSG(&err, msg);
+        }
+        
+        result = DBUS_HANDLER_RESULT_HANDLED;
+    } else if (dbus_message_is_signal(msg, OBEXD_DBUS_SRV_TRANS_IFC,
+                                      OBEXD_DBUS_SRV_TRANS_SGNL_PROGRESS)) {
+        int32_t total;
+        int32_t transferred;
+        
+        if (dbus_message_get_args(msg, &err,
+                                  DBUS_TYPE_INT32, &total,
+                                  DBUS_TYPE_INT32, &transferred,
+                                  DBUS_TYPE_INVALID)) {
+            const char *path = NULL;
+
+            path = dbus_message_get_path(msg);
+
+            if (path == NULL){
+                LOGE("Function %s:%d Unable to get path", 
+                         __FUNCTION__, __LINE__);
+            } else {
+                LOGV("... Transfer: %s Total = %d Transferred = %d", path, 
+                     total, transferred);
+
+                env->CallVoidMethod(nat->me, method_onObexProgress, 
+                                    env->NewStringUTF(path), (jint) transferred);
+            }
+        } else { 
+            LOG_AND_FREE_DBUS_ERROR_WITH_MSG(&err, msg);
+        }
+        
+        result = DBUS_HANDLER_RESULT_HANDLED;
+    }
+ 
+    if (result == DBUS_HANDLER_RESULT_NOT_YET_HANDLED) {
+        LOGE("... ignored");
+    }
+
+    if (env->ExceptionCheck()) {
+        LOGE("VM Exception occurred while handling %s.%s (%s) in %s,"
+             " leaving for VM",
+             dbus_message_get_interface(msg), dbus_message_get_member(msg),
+             dbus_message_get_path(msg), __FUNCTION__);
+    }
+
+    return result;
+}
