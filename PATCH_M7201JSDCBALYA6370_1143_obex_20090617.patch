+};
+
+
+static void onCreateSessionComplete(DBusMessage *msg, void *user) 
+{
+  LOGI(__FUNCTION__);
+  
+  char*          address = (char *)user;
+  DBusError  err;
+  jboolean      is_error = JNI_FALSE;
+  JNIEnv*       env = event_loop_nat->env;
+  char*           obj_path;
+  
+  dbus_error_init(&err);
+  
+  LOGI("... address = %s", address);
+  if (dbus_set_error_from_message(&err, msg)  ||
+        !dbus_message_get_args(msg, &err,
+                               DBUS_TYPE_OBJECT_PATH, &obj_path,
+                               DBUS_TYPE_INVALID)) 
+  {
+    LOGE("%s: D-Bus error: %s (%s)\n", __FUNCTION__, err.name, err.message);
+    
+    dbus_error_free(&err);
+    
+    env->CallVoidMethod(nat->me,
+                      method_onCreateSessionComplete,
+                      NULL,
+                      env->NewStringUTF(address),
+                      JNI_TRUE);
+     return;
+  }
+
+  LOGI(" object path = %s, is_error = %d\n", obj_path, is_error);
+
+  /* Add an object handler for FTP client agent method calls*/
+  if (!dbus_connection_register_object_path(nat->conn,
+                                            obj_path,
+                                            &ftpclient_agent_vtable, 
+                                            NULL)) 
+  {
+      LOGE("%s: Can't register object path %s for agent!",
+           __FUNCTION__, obj_path);
+           
+  }
+  else
+  {
+
+     DBusError err;
+     dbus_error_init(&err);
+     LOGI("Registered Object Path %s with dbus", obj_path);
+     DBusMessage *reply = dbus_func_args_error(env, nat->conn, &err, 
+                                                  OBEXD_DBUS_CLIENT_SVC, 
+                                                  obj_path,
+                                                  OBEXD_DBUS_CLIENT_SESSION_IFC, OBEXD_DBUS_CLIENT_SESSION_ASSIGN,
+                                                  DBUS_TYPE_OBJECT_PATH, &obj_path,
+                                                  DBUS_TYPE_INVALID);
+
+        if (reply) 
+        {
+            
+            LOGI("Added Object Path %s with BM3", obj_path);
+            dbus_message_unref(reply);
+        } 
+        else 
+        {
+            LOG_AND_FREE_DBUS_ERROR(&err);
+        }
+  }
+
+  env->CallVoidMethod(nat->me,
+                      method_onCreateSessionComplete,
+                      env->NewStringUTF(obj_path),
+                      env->NewStringUTF(address),
+                      is_error);
+                      
+  if (env->ExceptionCheck()) 
+  {
+     env->ExceptionDescribe();
+  }
+  
+  free(address);
+}
+
+static void onChangeFolderComplete(DBusMessage *msg, void *user) 
+{
+  LOGI(__FUNCTION__);
+  
+  callback_data_t *callback_userdata = (callback_data_t *)user;
+  DBusError  err;
+  jboolean      is_error = JNI_FALSE;
+  JNIEnv*       env = event_loop_nat->env;
+  
+  dbus_error_init(&err);
+  
+  LOGI("... session = %s ...folder = %s\n", callback_userdata->session, callback_userdata->folder);
+  if (dbus_set_error_from_message(&err, msg)) 
+  {
+    LOGE("%s: D-Bus error: %s (%s)\n", __FUNCTION__, err.name, err.message);
+    
+    dbus_error_free(&err);
+    
+    is_error = JNI_TRUE;
+  }
+  
+  env->CallVoidMethod(nat->me,
+                      method_onChangeFolderComplete,
+                      env->NewStringUTF(callback_userdata->session),
+                      env->NewStringUTF(callback_userdata->folder),
+                      is_error);
+                      
+  if (env->ExceptionCheck()) 
+  {
+      env->ExceptionDescribe();
+  }
+  
+  free( callback_userdata->session );
+  free( callback_userdata->folder );
+  free( callback_userdata );
+}
+static void onCreateFolderComplete(DBusMessage *msg, void *user) 
+{
+  LOGI(__FUNCTION__);
+  
+  callback_data_t *callback_userdata = (callback_data_t *)user;
