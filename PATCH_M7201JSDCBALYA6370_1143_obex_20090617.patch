+        mDeviceList.removeAll();
+        addDevices();
+
+        mLocalManager.registerCallback(this);
+        mLocalManager.startScanning(false);
+
+        registerReceiver(mReceiver,
+                new IntentFilter(BluetoothIntent.BLUETOOTH_STATE_CHANGED_ACTION));
