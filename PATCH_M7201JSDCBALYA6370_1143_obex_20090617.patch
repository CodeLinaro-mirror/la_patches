+  }
+  
+  free( callback_userdata->session );
+  free( callback_userdata->folder );
+  free( callback_userdata );
+}
+
+
+static void onListFolderComplete(DBusMessage *msg, void *user) 
+{
+  LOGI(__FUNCTION__);
+  
+  char*          session = (char *)user;
+  DBusError  err;
+  jboolean      is_error = JNI_FALSE;
+  JNIEnv*       env = event_loop_nat->env;
+  jobjectArray result = NULL;
+  jobject         obj;
+  
+  dbus_error_init(&err);
+  
+  LOGI("onListFolderComplete... session = %s", session);
+  if (dbus_set_error_from_message(&err, msg)) 
+  {
+    LOGE("%s: D-Bus error: %s (%s)\n", __FUNCTION__, err.name, err.message);
+    
+    dbus_error_free(&err);
+ 
+    env->CallVoidMethod(nat->me,
+                      method_onListFolderComplete,
+                      env->NewStringUTF(session),
+                      result,
+                      JNI_TRUE);
+     free(session);
+     return;
+  }
+  DBusMessageIter iter, array;
+  const char *name = NULL, *type = NULL, *permission = NULL;
+  uint64_t size = 0, modified = 0, accessed = 0, created = 0;
+  int array_count = 0;
+
+  if(!dbus_message_iter_init(msg, &iter))
+  {
+      LOGE("%s: D-Bus msg not valid\n", __FUNCTION__);
+      env->CallVoidMethod(nat->me,
+                      method_onListFolderComplete,
+                      env->NewStringUTF(session),
+                      result,
+                      JNI_TRUE);
+      free(session);
+      return;
+  }
+
+  dbus_message_iter_recurse(&iter, &array);
+
+  while( dbus_message_iter_get_arg_type(&array) != DBUS_TYPE_INVALID )
+  {
+      array_count++;
+      dbus_message_iter_next(&array);
+  }
+  LOGI(" No of array element = %d\n", array_count );
+
+  if(!dbus_message_iter_init(msg, &iter))
+  {
+      LOGE("%s: D-Bus msg not valid\n", __FUNCTION__);
+      env->CallVoidMethod(nat->me,
+                      method_onListFolderComplete,
+                      env->NewStringUTF(session),
+                      result,
+                      JNI_TRUE);
+      free(session);
+      return;
+  }
+  dbus_message_iter_recurse(&iter, &array);
+
+  jclass array_clazz = env->FindClass("android/server/BluetoothFtpService$ObjectProperties");
+  if( !array_clazz )
+  {
+    LOGI("%s:%d Cannot FindClass", __FUNCTION__, __LINE__);
+
+     env->CallVoidMethod(nat->me,
+                    method_onListFolderComplete,
+                    env->NewStringUTF(session),
+                    result,
+                    JNI_TRUE);
+     free(session);
+     return;
+  }
+ 
+  result = env->NewObjectArray( array_count, array_clazz, NULL );
+
+   if (env->ExceptionCheck()) {
+            env->ExceptionDescribe();
+            }
+  if (result == NULL)
+  {
+      LOGI("%s:%d Cannot Construct an Array", __FUNCTION__, __LINE__);
+
+      env->CallVoidMethod(nat->me,
+                  method_onListFolderComplete,
+                  env->NewStringUTF(session),
+                  result,
+                  JNI_TRUE);
+     free(session);
+     return;      
+  }
+
+  for( int i = 0; i < array_count; i++)
+  {
+    DBusMessageIter arr_element;
+
+    dbus_message_iter_recurse(&array, &arr_element);
+    
+    while (dbus_message_iter_get_arg_type(&arr_element) == DBUS_TYPE_DICT_ENTRY)
+    {
+      const char *dict_key;
+      DBusMessageIter dict_entry, dict_variant;
+
+      dbus_message_iter_recurse(&arr_element, &dict_entry);
+
+      dbus_message_iter_get_basic(&dict_entry, &dict_key);
+
+      dbus_message_iter_next(&dict_entry);
+
+      dbus_message_iter_recurse(&dict_entry, &dict_variant);
+
+      int32_t itr_type;
+
+      itr_type = dbus_message_iter_get_arg_type(&dict_variant);
+      if ((itr_type == DBUS_TYPE_STRING) || (itr_type == DBUS_TYPE_UINT64)) 
+      {
+         
+          if (!strncmp(dict_key, "Name", sizeof("Name"))) 
+          {
+              dbus_message_iter_get_basic(&dict_variant, &name);
+              LOGI("...Name...%s", name );
+          } 
+          else if (!strncmp(dict_key, "Type", sizeof("Type"))) 
+          {
+              dbus_message_iter_get_basic(&dict_variant, &type);
+               LOGI("...Type...%s", type );
+          } 
+          else if (!strncmp(dict_key, "Size", sizeof("Size"))) 
+          {
+              dbus_message_iter_get_basic(&dict_variant, &size);
+               LOGI("...Size...%d", (int32_t)size );
+          } 
+          else if (!strncmp(dict_key, "Permission", sizeof("Permission")))
+          {
+              dbus_message_iter_get_basic(&dict_variant, &permission);
+               LOGI("...Permission... %s", permission);
+          }
+          else if (!strncmp(dict_key, "Modified", sizeof("Modified")))
+          {
+              dbus_message_iter_get_basic(&dict_variant, &modified);
+               LOGI("...Modified...%d", (int32_t)modified);
+          }
+          else if (!strncmp(dict_key, "Accessed", sizeof("Accessed")))
+          {
+              dbus_message_iter_get_basic(&dict_variant, &accessed);
+               LOGI("...Accessed...%d", (int32_t)accessed );
+          }
+          else if (!strncmp(dict_key, "Created", sizeof("Created")))
+          {
+              dbus_message_iter_get_basic(&dict_variant, &created);
+               LOGI("...Created...%d", (int32_t)created);
+          }
+      }
+
+      dbus_message_iter_next(&arr_element);
+    }
+
+    LOGI("Folder info: Name = %s   Type = %s Size = %d", name , type,  (int32_t)size);
+    LOGI(" Permission = %s Modified = %d Accessed = %d Created = %d", permission,(int32_t) modified, (int32_t)accessed, (int32_t)created);
+      
+    jclass clazz = 
+    env->FindClass("android/server/BluetoothFtpService$ObjectProperties");
+
+    if (clazz == NULL)
+    {
+        LOGI("%s:%d Cannot FindClass", __FUNCTION__, __LINE__);
+
+        env->CallVoidMethod(nat->me,
+                    method_onListFolderComplete,
+                    env->NewStringUTF(session),
+                    result,
+                    JNI_TRUE);
+     free(session);
+     return;      
+    }
+     LOGI("find class %d", __LINE__ );
+    jmethodID constructor = env->GetMethodID(clazz,"<init>",
+                                           "(Landroid/server/BluetoothFtpService;Ljava/lang/String;Ljava/lang/String;ILjava/lang/String;III)V");
+
+    if (constructor == NULL)
+    {
+       LOGE("%s:%d Cannot Get Constructor", __FUNCTION__, __LINE__);
+
+       env->CallVoidMethod(nat->me,
+                    method_onListFolderComplete,
+                    env->NewStringUTF(session),
+                    result,
+                    JNI_TRUE);
+       free(session);
+       return;
+     }
+
+    /* Creating new object "ObjectProperties" and initializing  */
+    obj = env->NewObject(clazz, constructor, nat->me,
+                              env->NewStringUTF(name), env->NewStringUTF(type), (jint) size,
+                              env->NewStringUTF(permission), (jint)modified, (jint)accessed, (jint)created);
+
+    if (env->ExceptionCheck()) 
+    {
+        LOGE("VM Exception occurred in native function %s (%s:%d)",
+            __FUNCTION__, __FILE__, __LINE__);
+    }
+
+    /* Populating the array with object  */
+    env->SetObjectArrayElement( result, i, obj );
+
+    if (env->ExceptionCheck()) 
+    {
+        env->ExceptionDescribe();
+    }
+    dbus_message_iter_next(&array);
+  }// for loop
+
+  env->CallVoidMethod(nat->me,
+                      method_onListFolderComplete,
+                      env->NewStringUTF(session),
+                      result,
+                      is_error);
+  if (env->ExceptionCheck()) 
+  {
+    env->ExceptionDescribe();
+  }
+
+  free(session);
+}
