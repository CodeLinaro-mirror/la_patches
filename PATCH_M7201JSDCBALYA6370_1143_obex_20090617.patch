+            }
+         }
+      }
+   }
+
+   public void unRegisterBluetoothOBexIntentHandler() {
+      synchronized (this) {
+         if (mRegisteredBroadcasts ==  true) {
+            mActivity.unregisterReceiver(mBroadcastReceiver);
+            mRegisteredBroadcasts = false;
+            if (V) {
