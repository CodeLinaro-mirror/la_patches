+package com.google.gerrit.reviewdb;
+
+import com.google.gwtorm.client.Access;
+import com.google.gwtorm.client.OrmException;
+import com.google.gwtorm.client.PrimaryKey;
+import com.google.gwtorm.client.Query;
+import com.google.gwtorm.client.ResultSet;
+
+/** Access interface for {@link Search}. */
+public interface SearchAccess extends Access<Search, Search.Key> {
+  /** Locate a search by our locally generated identity. */
+  @PrimaryKey("key")
+  Search byKey(Search.Key key) throws OrmException;
+
+  @Query("WHERE key.owner.type = ? AND key.owner.id = ?")
+  ResultSet<Search> byType(char t, String id) throws OrmException;
+}
