+        Label filter = new Label(info.getWatch().getFilter());
         filter.setStyleName(Gerrit.RESOURCES.css().watchedProjectFilter());
         fp.add(filter);
       }
 
       table.setWidget(row, 1, new CheckBox());
       table.setWidget(row, 2, fp);
