+// ~we should be keeping track of the outstanding RPCs so that
+// we can keep the buttons disabled during them.
+
+  protected void display(final DashInfo info) {
+    DashInfo old = this.info;
+    this.info = info;
+
+    DashChangeTable.this.setButtonsEnabled(false);
+
+    List<DashSection> sections = split.getBoundIndices();
+
+    // remove potentially old entries
+    if (sections.size() > 0) {
+      List<DashSearch.Key> infoKeys = new ArrayList<DashSearch.Key>(
+        info.getDashSearches().size());
+      for (DashSearch ds : info.getDashSearches()) {
+        infoKeys.add(ds.getKey());
+      }
+
+      for (int i = sections.size(); i > 0; i--) {
+        DashSection section = sections.get(i-1);
+        if (! infoKeys.contains(section.getDSearch().getKey())) {
+          section.detach();
+        }
+      }
+    }
+
+    // Add new, or reposition entries.  Keep track of whether
+    // a section was minimized or not when moving it.
+    Map<DashSearch,Boolean> isVisibleBy = new HashMap<DashSearch,Boolean>();
+    int expandable = 100; // 100 is dashboard max ~ should use Gerrit prop
+    int pos = 0;
+    for (final DashSearch ds : info.getDashSearches()) {
+      int i = indexOf(ds);
+      if (i != -1 && i != pos) {
+        if (i != -1) {
+          isVisibleBy.put(ds, sections.get(i).data.isVisible());
+        }
+        sections.get(i).detach();
+        i = -1;
+      }
+
+      if (i == -1) {
+        final DashSection section = new DashSection(ds);
+        Boolean isVisible = isVisibleBy.get(ds);
+        if (isVisible != null) {
+          section.bar.onMinimize(! isVisible);
+        }
+        section.attach(pos);
+        section.loadSearch();
+      }
+
+      pos ++;
+      expandable -= ds.getMax();
+    }
+
+    for (int i = 0; i < sections.size(); i++) {
+      DashSection s = sections.get(i);
+      s.setTop(i == 0);
+      s.setBottom(i == sections.size() - 1);
+      s.editor.setHardMax(s.getDSearch().getMax() + expandable);
+    }
+
+    DashChangeTable.this.setButtonsEnabled(true);
+  }
+
+  public void setButtonsEnabled(boolean enabled) {
+    List<DashSection> sections = split.getBoundIndices();
+    for (DashSection s: sections) {
+      s.bar.setButtonsEnabled(enabled);
+    }
+  }
+
+  public int indexOf(DashSearch ds) {
+    int i = 0;
+    List<DashSection> sections = split.getBoundIndices();
+    for (DashSection section : sections) {
+      if (ds.getKey().equals(section.getDSearch().getKey())) {
+        return i;
+      }
+      i++;
+    }
+    return -1;
+  }
+}
