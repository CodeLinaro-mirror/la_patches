+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package com.google.gerrit.client.searches;
+
+import com.google.gerrit.client.ui.HintTextBox;
+import com.google.gerrit.client.ui.AccountSuggestOracle;
+import com.google.gerrit.client.ui.AccountGroupSuggestOracle;
+import com.google.gerrit.client.ui.OnEditEnabler;
+import com.google.gerrit.client.ui.ProjectNameSuggestOracle;
+import com.google.gerrit.client.ui.RPCSuggestOracle;
+import com.google.gerrit.client.ui.SwitchingSuggestOracle;
+import com.google.gerrit.client.ui.TextBoxBaseListener;
+import com.google.gerrit.common.data.OwnedList;
+import com.google.gerrit.reviewdb.Owner;
+
+import com.google.gwt.event.dom.client.ChangeEvent;
+import com.google.gwt.event.dom.client.ChangeHandler;
+import com.google.gwt.event.dom.client.ClickEvent;
+import com.google.gwt.event.dom.client.ClickHandler;
+import com.google.gwt.user.client.ui.Button;
+import com.google.gwt.user.client.ui.Composite;
+import com.google.gwt.user.client.ui.FocusWidget;
+import com.google.gwt.user.client.ui.ListBox;
+import com.google.gwt.user.client.ui.SuggestBox;
+import com.google.gwt.user.client.ui.SuggestOracle;
+import com.google.gwtexpui.globalkey.client.NpTextBox;
+
+public abstract class OwnedEditor<OK extends Owner.OwnedKey,
+    OL extends OwnedList> extends Composite {
+  protected HintTextBox name;
+  protected NpTextBox owner;
+  protected SuggestBox ownerSug;
+  protected ListBox type;
+
+  protected Button save;
+  protected Button insert;
+  protected Button cancel;
+
+  protected SwitchingSuggestOracle oracle;
+  protected OnEditEnabler enabler;
+  protected FocusWidget fake = new FocusWidget() {
+      @Override
+      public void setEnabled(boolean enabled) {
+        displayButtons(); // capture every change
+      }
+
+      @Override
+      public boolean isEnabled() {
+        // never shut off the events, allows us to disable the buttons also
+        return false;
+      }
+    };
+
+  private OL list;
+  private OK oKey;
+
+  public OwnedEditor() {
+    createWidgets();
+    setupWidgets();
+    setupValidators();
+    setupSaveEnablers();
+  }
+
+  public OwnedEditor(OK key) {
+    this();
+    setOwnedKey(key);
+  }
+
+  public void createWidgets() {
+    save = new Button();
+    save.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        onSave(false);
+      }
+    });
+
+    insert = new Button();
+    insert.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        onSave(true);
+      }
+    });
+
+    cancel = new Button();
+    cancel.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        onCancel();
+      }
+    });
+
+    name = new HintTextBox();
+
+    type = new ListBox();
+    for (Owner.Type t : Owner.Type.values()) {
+      type.addItem(t.getId(), t.getId());
+    }
+    type.addChangeHandler(new ChangeHandler() {
+      @Override
+      public void onChange(ChangeEvent event) {
+        onTypeChange();
+      }
+    });
+
+    owner = new NpTextBox();
+    oracle = createOracle();
+    ownerSug = new SuggestBox(new RPCSuggestOracle(oracle), owner);
+
+    enabler = new OnEditEnabler(fake);
+  }
+
+  public SwitchingSuggestOracle createOracle() {
+    SuggestOracle[] oracles = new SuggestOracle[3];
+    oracles[0] = new AccountSuggestOracle();
+    oracles[1] = new AccountGroupSuggestOracle();
+    oracles[2] = new ProjectNameSuggestOracle();
+    return new SwitchingSuggestOracle(oracles);
+  }
+
+  public abstract void setupWidgets();
+
+  public void setupValidators() {
+    TextBoxBaseListener validator = new TextBoxBaseListener(name) {
+      @Override
+      public void onTextChange(String old, String val) {
+        if (! name.isHintOn() && ! getOrigOwnedKey().isValidName(val)) {
+          name.setText(old);
+        }
+      }
+    };
+  }
+
+  public void setupSaveEnablers() {
+    enabler.listenTo(name);
+    enabler.listenTo(owner);
+    if (getOrigOwnedKey() == null || // New
+        getOwnedList() != null && ! getOwnedList().isEditable()) {
+        // or uneditable, but copyable to another owner
+      save.setVisible(false);
+    } else { // Editable, and copyable
+      save.setVisible(true);
+    }
+  }
+
+  public OK getOrigOwnedKey() {
+    return oKey;
+  }
+
+  public Owner.Id getOrigOwnerId() {
+    if (oKey == null) {
+      if (list == null) {
+        return new Owner.Id(Owner.Type.USER, "");
+      }
+      return list.getOwnerInfo().getId();
+    }
+    return oKey.getOwnerId();
+  }
+
+  protected String getNameText() {
+    return name.getText();
+  }
+
+  protected void setNameText(String nameText) {
+    name.setText(nameText);
+  }
+
+  public abstract OK getOwnedKey();
+
+  protected void setOwnedKey(OK ok) {
+    oKey = ok;
+    setNameText(ok == null ? "": ok.get());
+    if (ok == null || ok.getType() == null) {
+      displayType(list == null ? Owner.Type.USER : list.getType());
+    } else {
+      displayType(ok.getType());
+    }
+    onTypeChange();
+  };
+
+  public OL getOwnedList() {
+    return list;
+  }
+
+  public void setOwnedList(OL list) {
+    this.list = list;
+    if (list != null) {
+      displayType(list.getType());
+    }
+  }
+
+  public void onTypeChange() {
+    displayOwner();
+    displayButtons();
+  }
+
+  protected void displayType(Owner.Type t) {
+    int i = 0;
+    for (Owner.Type st : Owner.Type.values()) {
+      if (st.equals(t)) {
+        type.setSelectedIndex(i);
+      }
+      i++;
+    }
+  }
+
+  protected Owner.Type getType() {
+    return Owner.Type.forId(type.getValue(type.getSelectedIndex()));
+  }
+
+  protected void displayOracle() {
+    switch(getType()) {
+      case USER:    oracle.setIndex(0); break;
+      case GROUP:   oracle.setIndex(1); break;
+      case PROJECT: oracle.setIndex(2); break;
+    }
+  }
+
+  protected void disableButtons() {
+    cancel.setEnabled(false);
+    save.setEnabled(false);
+    insert.setEnabled(false);
+  }
+
+  protected void displayButtons() {
+    cancel.setEnabled(true);
+
+    if (getOrigOwnedKey() == null) {
+      // New
+      save.setVisible(false);
+      insert.setEnabled(isValidInsert());
+    } else if (getOwnedList() != null && ! getOwnedList().isEditable()) {
+      // Uneditable, but copyable to another owner
+      save.setVisible(false);
+      insert.setEnabled(false);
+    } else {
+      // Editable, and copyable
+      save.setVisible(true);
+      if (isChangedOwner()) {
+        save.setEnabled(false);
+        insert.setEnabled(isValidInsert());
+      } else if (isChangedName()) {
+        save.setEnabled(isValidSave());
+        insert.setEnabled(isValidInsert());
+      } else if (isChangedOther()) {
+        save.setEnabled(isValidSave());
+        insert.setEnabled(false);
+      } else {
+        save.setEnabled(false);
+        insert.setEnabled(false);
+      }
+    }
+  }
+
+  protected void debugButtons() {
+    StringBuffer b = new StringBuffer();
+    if (getOrigOwnedKey() == null) {
+      b.append("New");
+      b.append(" isValidInsert:"+isValidInsert());
+    } else if (getOwnedList() != null && ! getOwnedList().isEditable()) {
+      b.append("Uneditable");
+    } else {
+      b.append("Editable");
+      if (isChangedOwner()) {
+        b.append(" changed owner");
+        b.append(" isValidInsert:"+isValidInsert());
+      } else if (isChangedName()) {
+        b.append(" changed name");
+        b.append(" isValidSave:"+isValidSave());
+        b.append(" isValidInsert:"+isValidInsert());
+      } else if (isChangedOther()) {
+        b.append(" changed other");
+        b.append(" isValidSave:"+isValidSave());
+      } else {
+        b.append(" no change");
+      }
+    }
+    com.google.gwt.user.client.Window.alert(b.toString());
+  }
+
+  protected void displayOwner() {
+    displayOwnerType(getOwnerTypeText());
+    displayOracle();
+    displayOwnerText();
+  }
+
+  public void displayOwnerText() {
+    if (getOrigOwnerId().getType() != getType()) {
+      if (getOrigOwnerId().get() != null && getOrigOwnerForDisplay().equals(owner.getText())) {
+        owner.setText("");
+      }
+    } else if ("".equals(owner.getText())) {
+      owner.setText(getOrigOwnerForDisplay());
+    }
+  }
+
+  public Owner.Id getOwnerId() {
+    return new Owner.Id(getType(), getOwner());
+  }
+
+  public String getOwner() {
+    if (getType() == Owner.Type.USER || getType() == Owner.Type.SITE) {
+      return "";
+    }
+    if (getOrigOwnerForDisplay().equals(owner.getText())) {
+      // When the owner doesn't change, keep the same id on "updated"
+      // search so that others may detect changes based on the id.
+      return getOrigOwnerId().get();
+    }
+    return owner.getText();
+  }
+
+  protected String getOrigOwnerForDisplay() {
+    if (getOwnedList() != null && getOwnedList().getOwnerInfo() != null) {
+      return getOwnedList().getOwnerInfo().getOwnerForDisplay();
+    }
+    return "";
+  }
+
+  protected void displayOwnerType(String txt) {
+    ownerSug.setVisible(! "".equals(txt));
+  }
+
+  protected String getOwnerTypeText() {
+    switch(getType()) {
+      case GROUP:   return Util.C.columnOwnerEditGroup();
+      case PROJECT: return Util.C.columnOwnerEditProject();
+    }
+    return "";
+  }
+
+  public boolean isValidSave() {
+    return getOwnedKey().isValid();
+  }
+
+  public boolean isValidInsert() {
+    // A new blank name is valid so "save service" can use a default
+    // name such as "untitled".
+    return isValidSave() || "".equals(getOwnedKey().get());
+  }
+
+  public boolean isChangedOther() {
+    return false;
+  }
+
+  public boolean isChangedName() {
+    if (getOrigOwnedKey() == null) {
+      return true;
+    }
+    return ! getNameText().equals(getOrigOwnedKey().get());
+  }
+
+  public boolean isChangedOwner() {
+    if (getType() != getOrigOwnerId().getType()) {
+      return true;
+    }
+    if (getType() == Owner.Type.USER || getType() == Owner.Type.SITE) {
+      return false;
+    }
+
+    return ! getOwnerId().equals(getOrigOwnedKey().getOwnerId()) &&
+      ! getOrigOwnerForDisplay().equals(owner.getText());
+  }
+
+  public boolean isChanged() {
+    return isChangedOther() || isChangedName() || isChangedOwner();
+  }
+
+  public void onSave(boolean insert) {
+    disableButtons();
+  }
+
+  public void onCancel() {
+  }
+}
