+
+public class DashTable extends NavigationTable<Dash> {
+  private static int HIDDEN = -1;
+
+  protected DashEditor<DashList> editor;
+  private DashList list;
+  private int editorRow = HIDDEN;
+  private int columns;
+  private boolean inserting = false;
+
+  public DashTable() {
+    keysNavigation.add(new PrevKeyCommand(0, 'k', Util.C.dashListPrev()));
+    keysNavigation.add(new NextKeyCommand(0, 'j', Util.C.dashListNext()));
+    keysNavigation.add(new OpenKeyCommand(0, 'o', Util.C.dashListOpen()));
+    keysNavigation.add(new OpenKeyCommand(0, KeyCodes.KEY_ENTER, Util.C.dashListOpen()));
+
+    table.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(ClickEvent event) {
+        final Cell cell = table.getCellForEvent(event);
+        if (cell != null && cell.getCellIndex() != 1
+            && getRowItem(cell.getRowIndex()) != null) {
+          movePointerTo(cell.getRowIndex());
+        }
+      }
+    });
+
+    editor = createDashEditor();
+  }
+
+  public void setDashList(DashList list, Dash dash) {
+    this.list = list;
+    editor.setOwnedList(list);
+    refresh(dash);
+  }
+
+  @Override
+  public Integer getRowItemKey(Dash dash) {
+    return dash.getId();
+  }
+
+  @Override
+  public void onOpenRow(int row) {
+    if (row > 0) {
+      movePointerTo(row);
+    }
+  }
+
+  @Override
+  public void movePointerTo(int row) {
+    if (editorRow == (row + 1) && ! inserting) {
+      editor.onCancel();
+    } else {
+      if (editorRow != HIDDEN && editorRow < row) {
+        row--;
+      }
+      hideEditor();
+      super.movePointerTo(row);
+      showEditor(row);
+    }
+  }
+
+  protected void showEditor(int row) {
+    hideEditor();
+    if (list.isEditable()) {
+      if (row > 0) {
+        editor.setDash(getRowItem(row));
+      } else if (row == -1) {
+        row = table.getRowCount() - 1;
+        editor.setDash(new Dash(null));
+        inserting = true;
+        clearPointer();
+      }
+      editorRow = row + 1;
+      table.insertRow(editorRow);
+      table.setWidget(editorRow, 0, editor);
+      final FlexCellFormatter fmt = table.getFlexCellFormatter();
+      fmt.setColSpan(editorRow, 0, columns);
+      fmt.addStyleName(editorRow, 0, Gerrit.RESOURCES.css().dataHeader());
+    }
+  }
+
+  protected void hideEditor() {
+    if (editorRow > 0) {
+      table.removeRow(editorRow);
+    }
+    editorRow = HIDDEN;
+    inserting = false;
+  }
+
+  private String link(final Dash.Key k) {
+    Owner.Type type = k.getOwnerId().getType();
+    String owner = list.getOwnerInfo().getOwnerForLink();
+    String name = k.get();
+    return Dispatcher.toDash(type, owner, name);
+  }
+
+  public void refresh(Dash dash) {
+    hideEditor();
+    display(list.getDashes());
+    if (dash != null) {
+      movePointerTo(dash.getId());
+      hideEditor();
+    }
+  }
+
+  protected void display(final List<Dash> dashes) {
+    while (0 < table.getRowCount())
+      table.removeRow(table.getRowCount() - 1);
+
+    populateHeader();
+    if (dashes.isEmpty()) {
+      insertNoneRow(1);
+    } else {
+      for (final Dash d: dashes) {
+        final int row = table.getRowCount();
+        table.insertRow(row);
+        applyDataRowStyle(row);
+        populate(row, d);
+      }
+    }
+  }
+
+  private void insertNoneRow(final int row) {
+    table.insertRow(row);
+    table.setText(row, 0, Util.C.dashTableNone());
+    final FlexCellFormatter fmt = table.getFlexCellFormatter();
+    fmt.setColSpan(row, 0, columns);
+    fmt.setStyleName(row, 0, Gerrit.RESOURCES.css().emptySection());
+  }
+
+  protected void populate(final int row, final Dash dash) {
+    int col = 1;
+    Hyperlink link = new Hyperlink(dash.getKey().get(), link(dash.getKey()));
+    table.setWidget(row, col++, link);
+    table.setText(row, col++, dash.getDescription());
+
+    final FlexCellFormatter fmt = table.getFlexCellFormatter();
+    for (col-- ; col >=0 ; col--)
+      fmt.addStyleName(row, col, Gerrit.RESOURCES.css().dataCell());
+
+    col = 1;
+    fmt.addStyleName(row, col++, Gerrit.RESOURCES.css().cPROJECT());
+    fmt.addStyleName(row, col++, Gerrit.RESOURCES.css().cPROJECT());
+
+    setRowItem(row, dash);
+  }
+
+  void populateHeader() {
+    int row = 0;
+    int col = 1;
+    table.setText(row, col++, Util.C.columnDashName());
+    table.setText(row, col++, Util.C.columnDashDescription());
+
+    final FlexCellFormatter fmt = table.getFlexCellFormatter();
+    col = 0;
+    fmt.addStyleName(row, col++, Gerrit.RESOURCES.css().iconHeader());
+    fmt.addStyleName(row, col++, Gerrit.RESOURCES.css().dataHeader());
+    fmt.addStyleName(row, col++, Gerrit.RESOURCES.css().dataHeader());
+    columns = col;
+  }
+
+  protected DashEditor createDashEditor() {
+    return new Editor(null);
+  }
+
+  protected class Editor extends DashEditor<DashList> {
+    public Editor(Dash dash) {
+      super(dash);
+    }
+
+    @Override
+    public void onSave(final Dash dash, final GerritCallback<DashList> cb) {
+      Util.DASH_SVC.saveDashL(dash, cb);
+    }
+
+    @Override
+    public void onCancel() {
+      super.onCancel();
+      hideEditor();
+    }
+  }
+}
