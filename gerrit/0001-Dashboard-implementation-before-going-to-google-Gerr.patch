+package com.google.gerrit.client.changes;
+
+import com.google.gerrit.client.patches.PatchUtil;
+import com.google.gerrit.client.ui.SplitList;
+import com.google.gerrit.common.data.ChangeInfo;
+import com.google.gerrit.common.data.SingleListChangeInfo;
+import com.google.gerrit.reviewdb.Account;
+import com.google.gerrit.reviewdb.Change;
+import com.google.gwt.user.client.ui.Widget;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+public class SplitChangeTable<BI extends SplitList.BoundIndex>
+    extends ChangeTable {
+
+  public enum ApprovalViewType {
+    NONE, USER, STRONGEST
+  }
+
+  public class Data extends SplitList.Section {
+    final ApprovalViewType viewType;
+    final Account.Id ownerId;
+    boolean hasNoneRow = false;
+    boolean isVisible = true;
+
+    public Data(final SplitList split, final ApprovalViewType view,
+        final Account.Id owner) {
+      split.super();
+      viewType = view;
+      ownerId = owner;
+    }
+
+    public void attach(final int i) {
+      super.attach(i);
+      insertNoneRow(0);
+    }
+
+    public void detach() {
+      super.detach();
+      hasNoneRow = false;
+    }
+
+    public void insertNoneRow(final int myRow) {
+      int row = add(myRow);
+      applyNoneRowStyle(row);
+      populateNoneRow(row);
+      hasNoneRow = true;
+    }
+
+    public void insertChangeRow(final int myRow) {
+      applyDataRowStyle(add(myRow));
+    }
+
+    public int remove(final int myRow) {
+      if (myRow == 0 && hasNoneRow) {
+        hasNoneRow = false;
+      }
+      return super.remove(myRow);
+    }
+
+    public void display(final List<ChangeInfo> changeList) {
+      assert isAttached();
+      final int sz = changeList != null ? changeList.size() : 0;
+
+      while (sz < getSize()) {
+        remove(0);
+      }
+
+      if (sz == 0) {
+        if (!hasNoneRow) {
+          insertNoneRow(0);
+        }
+      } else {
+        Set<Change.Id> cids = new HashSet<Change.Id>();
+
+        if (hasNoneRow) {
+          remove(0);
+        }
+
+        while (getSize() < sz) {
+          int r = getSize();
+          insertChangeRow(r);
+          table.getRowFormatter().setVisible(indexOf(r), isVisible());
+        }
+
+        for (int i = 0; i < sz; i++) {
+          ChangeInfo c = changeList.get(i);
+          populateChangeRow(indexOf(i), c);
+          cids.add(c.getId());
+        }
+
+        switch (viewType) {
+          case NONE:
+            break;
+          case USER:
+            PatchUtil.DETAIL_SVC.userApprovals(cids, ownerId,
+                approvalFormatter(indexOf(0), getSize(), true));
+            break;
+          case STRONGEST:
+            PatchUtil.DETAIL_SVC.strongestApprovals(cids,
+                approvalFormatter(indexOf(0), getSize(), false));
+            break;
+        }
+      }
+    }
+
+    public void setVisible(boolean visible) {
+      for (int r = 0; r < getSize(); r++) {
+        table.getRowFormatter().setVisible(indexOf(r), visible);
+      }
+      isVisible = visible;
+    }
+
+    public boolean isVisible() {
+      return isVisible;
+    }
+  }
+
+  public class TextTitle extends SplitList.Section {
+    String title;
+
+    public TextTitle(final SplitList split, final String title) {
+      split.super();
+      this.title = title;
+    }
+
+    public void attach(final int i) {
+      super.attach(i);
+      insertTitleRow(0, title);
+    }
+
+    public void insertTitleRow(final int myRow, String title) {
+      int row = add(myRow);
+      applyTitleRowStyle(row);
+      populateTitleRow(row, title);
+    }
+  }
+
+  public class WidgetTitle extends SplitList.Section {
+    Widget widget;
+
+    public WidgetTitle(final SplitList split, final Widget w) {
+      this(split);
+      widget = w;
+    }
+
+    public WidgetTitle(final SplitList split) {
+      split.super();
+    }
+
+    public void setWidget(Widget w) {
+      widget = w;
+      if (isAttached()) {
+        populateTitleRow(indexOf(0), widget);
+      }
+    }
+
+    public void attach(final int i) {
+      super.attach(i);
+      insertTitleRow(0, widget);
+    }
+
+    public void insertTitleRow(final int myRow, Widget title) {
+      int row = add(myRow);
+      applyTitleRowStyle(row);
+      populateTitleRow(row, title);
+    }
+  }
+
+  public class Section extends SplitList.SplitSection {
+    SplitList.Section title;
+    Data data;
+
+    public Section(final ApprovalViewType view,
+        final Account.Id owner) {
+      split.super();
+      data = new Data(getChildSplitList(), view, owner);
+    }
+
+    public Section(final String title, final ApprovalViewType view,
+      final Account.Id owner) {
+      this(view, owner);
+      setTitleText(title);
+    }
+
+    public Section(final String title) {
+      this(title, ApprovalViewType.NONE, null);
+    }
+
+    public void setTitleText(final String title) {
+      setTitle(new TextTitle(getChildSplitList(), title));
+    }
+
+    public void setTitle(final SplitList.Section t) {
+      if (title != null && title.isAttached()) {
+        title.detach();
+      }
+      title = t;
+      if (title != null && isAttached()) {
+        title.attach(0);
+      }
+    }
+
+    public void attach(final int i) {
+      super.attach(i);
+      data.attach(0);
+      if (title != null) {
+        title.attach(0);
+      }
+    }
+
+    public void display(final List<ChangeInfo> changeList) {
+      data.display(changeList);
+    }
+  }
+
+  public SplitList split = new SplitList(createResizeable()) {
+      @Override
+      public int getStart() {
+        return 1; // offset for the column header row
+      }
+    };
+
+  public SplitChangeTable() {
+    this(false);
+  }
+
+  public SplitChangeTable(final boolean showApprovals) {
+    super(false);
+  }
+
+  protected SplitList.Resizeable createResizeable() {
+    return new SplitList.Resizeable() {
+        @Override
+        public void add(int i) {
+          table.insertRow(i);
+        }
+        @Override
+        public void remove(int i) {
+          table.removeRow(i);
+        }
+      };
+  }
+}
