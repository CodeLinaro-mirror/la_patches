+
+package com.google.gerrit.client.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class SplitList<BI extends SplitList.BoundIndex> {
+
+  /* Use this interface to wrap the object which a SplitList
+   * operates on, the object that it will "split" and manage the
+   * subsections of.  Could be a List, a table... It just needs
+   * methods to expand and shrink it.
+   */
+  public interface Resizeable {
+    public void add(int i);
+    public void remove(int i);
+  }
+
+  /* Simple internal Index class to manage a start position and size */
+  protected static class Index {
+    private int start = -1;
+    private int size;
+
+    public int getSize() {
+      return size;
+    }
+
+    protected void setSize(final int s) {
+      size = s;
+    }
+
+    public int getStart() {
+      return start;
+    }
+
+    protected void setStart(final int i) {
+      start = i;
+    }
+
+    public void incrementStart(final int i) {
+      setStart(getStart() + i);
+    }
+
+    public void incrementStart() {
+      incrementStart(1);
+    }
+
+    public void decrementStart(final int i) {
+      incrementStart(-i);
+    }
+
+    public void decrementStart() {
+      decrementStart(1);
+    }
+
+    public void incrementSize(final int i) {
+      setSize(getSize() + i);
+    }
+
+    public void incrementSize() {
+      incrementSize(1);
+    }
+
+    public void decrementSize() {
+      incrementSize(-1);
+    }
+  }
+
+  /* An index which is permanently bound to the outter SplitList
+   * This is primarily meant as an internal building block, not so
+   * useful on its own.  Use/override Section or SplitSection
+   * instead, they are meant as user APIs.
+   */
+  public class BoundIndex {
+    private Index index;
+
+    protected BoundIndex() {
+      this(new Index());
+    }
+
+    protected BoundIndex(final Index idx) {
+      setIndex(idx);
+    }
+
+    protected Index getIndex() {
+      return index;
+    }
+
+    protected void setIndex(final Index idx) {
+      index = idx;
+    }
+
+    protected SplitList getBoundSplitList() {
+      return SplitList.this;
+    }
+
+    public int getSize() {
+      return getIndex().getSize();
+    }
+
+    public boolean isAttached() {
+      return getIndex().getStart() != -1;
+    }
+
+    public void attach() {
+      attach(getBoundIndices().size());
+    }
+
+    public void attach(final int i) {
+      attachBoundIndex((BI) this, i);
+    }
+
+    public void detach() {
+      detachBoundIndex((BI) this);
+    }
+  }
+
+  /* This is the main class you should use or extend if you want to
+   * create Sections of a SplitList. Its limited public methods are
+   * similar to a subset of List's methods.
+   */
+  public class Section extends BoundIndex {
+
+    public Section() {
+      super();
+    }
+
+    public Section(final Index idx) {
+      super(idx);
+    }
+
+    public int add() {
+      return add(getSize());
+    }
+
+    public int add(final int myI) {
+      int pI = indexOf(myI);
+      addToBoundIndex((BI) this, pI);
+      return pI;
+    }
+
+    public int remove(final int myI) {
+      int pI = indexOf(myI);
+      removeFromBoundIndex((BI) this, pI);
+      return pI;
+    }
+
+    public void removeAll() {
+      for (int i = getSize(); i > 0; remove(--i)) ;
+    }
+
+    public int indexOf(final int myI) {
+      assert isAttached();
+      return getIndex().getStart() + myI;
+    }
+
+    public void detach() {
+      removeAll();
+      super.detach();
+    }
+  }
+
+
+  /* This is the class you should use or extend if you want to
+   * create a SplitList Section which can manage other Sections
+   * of a SplitList. Unlike a Section, it cannot have items
+   * added or removed directly from it, only Sections.
+   */
+  public class SplitSection<BI2 extends BoundIndex> extends BoundIndex {
+
+    /* A SplitList containing an Index which can be moved.
+     * Moving the Index, moves the entire list */
+    private class ChildSplitList extends SplitList<BI2> {
+      private Index index = createMyIndex();
+
+      public ChildSplitList(final SplitList.Resizeable r) {
+        super(r);
+      }
+
+      protected Index createMyIndex() {
+        return new Index() {
+
+          @Override
+          protected void setStart(final int i) {
+            int diff = i - getStart();
+
+            for (BI2 cidx : getBoundIndices()) {
+              cidx.getIndex().incrementStart(diff);
+            }
+
+            super.setStart(i);
+          }
+        };
+      }
+
+      @Override
+      protected int getStart() {
+        return index.getStart();
+      }
+
+      public Index getIndex() {
+        return index;
+      }
+    }
+
+
+    private ChildSplitList child;
+
+    public SplitSection() {
+      child = new ChildSplitList(createResizeable());
+      setIndex(child.getIndex());
+    }
+
+    protected SplitList.Resizeable createResizeable() {
+      return new SplitList.Resizeable() {
+
+        /* Do not use the index to translate child adds and
+         * removes since the child Sections translate
+         * directly to the top list's indices.  If they didn't,
+         * they would never be able to access objects related
+         * to the parent (such as a table) using their
+         * indexOf() method. */
+        @Override
+        public void add(final int pI) {
+          addToBoundIndex((BI) SplitSection.this, pI);
+        }
+
+        @Override
+        public void remove(final int pI) {
+          removeFromBoundIndex((BI) SplitSection.this, pI);
+        }
+      };
+    }
+
+    public void detach() {
+      for (int i = child.getBoundIndices().size(); i > 0;
+         child.getBoundIndices().get(--i).detach()) ;
+      super.detach();
+    }
+
+    /* Use the SplitList returned by this to create child Sections with */
+    public SplitList getChildSplitList() {
+      return child;
+    }
+  }
+
+
+  private Resizeable resizeable;
+  protected final List<BI> indices = new ArrayList<BI>();
+
+
+  public SplitList(final Resizeable r) {
+    resizeable = r;
+  }
+
+  protected int getStart() {
+    return 0;
+  }
+
+  public List<BI> getBoundIndices() {
+    return indices;
+  }
+
+  protected void addToBoundIndex(final BI idx, final int i) {
+    boolean found = false;
+
+    resizeable.add(i);
+    idx.getIndex().incrementSize();
+
+    for (BI cidx : indices) {
+      if (found) {
+        cidx.getIndex().incrementStart();
+      }
+      if (cidx == idx) {
+        found = true;
+      }
+    }
+  }
+
+  protected void removeFromBoundIndex(final BI idx, final int i) {
+    boolean found = false;
+
+    assert 0 <= i;
+
+    resizeable.remove(i);
+    idx.getIndex().decrementSize();
+
+    for (BI cidx : indices) {
+      if (found) {
+        cidx.getIndex().decrementStart();
+      }
+      if (cidx == idx) {
+        found = true;
+      }
+    }
+  }
+
+  protected void attachBoundIndex(final BI idx, final int i) {
+    assert idx.getIndex().getSize() == 0;
+    assert i >= 0;
+
+    int startIndex = getStart();
+    if (i < indices.size()) {
+      startIndex = indices.get(i).getIndex().getStart();
+    } else if (!indices.isEmpty()) {
+      Index lidx = indices.get(indices.size()-1).getIndex();
+      startIndex = lidx.getStart() + lidx.getSize();
+    }
+
+    idx.getIndex().setStart(startIndex);
+    indices.add(i, idx);
+  }
+
+  protected void detachBoundIndex(final BI idx) {
+    boolean found = false;
+    int size = idx.getIndex().getSize();
+
+    if (size != 0) {
+      for (BI cidx : indices) {
+        if (found) {
+          cidx.getIndex().decrementStart(size);
+        }
+        if (cidx == idx) {
+          found = true;
+        }
+      }
+    }
+    indices.remove(idx);
+    idx.getIndex().setStart(-1);
+  }
+}
