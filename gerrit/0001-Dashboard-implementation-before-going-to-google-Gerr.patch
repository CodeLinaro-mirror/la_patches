+package com.google.gerrit.reviewdb;
+
+import com.google.gwtorm.client.Column;
+
+public final class Dash {
+  /** unique identification of a Dash */
+  public static class Key extends Owner.OwnedKey {
+    private static final long serialVersionUID = 1L;
+
+    protected Key() {
+      super();
+    }
+
+    public Key(Key key) {
+      super(key.getOwnerId(), key.get());
+    }
+
+    public Key(final Owner.Id owner, final String name) {
+      super(owner, name);
+    }
+
+    public Key(final Owner.Type type, final String owner, final String name) {
+      super(type, owner, name);
+    }
+
+    public Key(final Account.Id owner, final String name) {
+      super(owner, name);
+    }
+
+    public Key(final AccountGroup.Id owner, final String name) {
+      super(owner, name);
+    }
+
+    public Key(final Project.NameKey owner, final String name) {
+      super(owner, name);
+    }
+
+    public Key(final String name) { // SITE
+      super(name);
+    }
+  }
+
+  /** Unique identifier of the Dash  */
+  @Column(id = 1)
+  protected Key key;
+
+  // 0 here indicates it is new.  Before inserting, 0 needs
+  // to be replaced with the next id from the sequence.
+  @Column(id = 2)
+  protected int id = 0;
+
+  @Column(id = 3, length = Integer.MAX_VALUE)
+  protected String description = "";
+
+  protected Dash() {
+  }
+
+  public Dash(final Key key) {
+    setKey(key);
+  }
+
+  public Dash(final Key key, final int id) {
+    setKey(key);
+    setId(id);
+  }
+
+  public Key getKey() {
+    return key;
+  }
+
+  public void setKey(final Key key) {
+    this.key = key;
+  }
+
+  public int getId() {
+    return id;
+  }
+
+  public void setId(final int id) {
+    this.id = id;
+  }
+
+  public String getDescription() {
+    return description;
+  }
+
+  public void setDescription(String description) {
+    this.description = Owner.notNull(description);
+  }
+
+  public void setDash(final Dash dash) {
+    setKey(dash.getKey());
+    setId(dash.getId());
+  }
+}
