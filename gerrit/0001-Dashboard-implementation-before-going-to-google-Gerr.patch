+  public DashSearchBar(final DashSearch dSearch, final DashInfo info) {
+    this.info = info;
+
+    maxcount = new Label("(-/" + dSearch.getMax() + ")");
+    minimize = new Image(Gerrit.RESOURCES.arrowOpen());
+    maximize = new Image(Gerrit.RESOURCES.arrowClosed());
+
+    minimize.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        onMinimize(true);
+      }
+    });
+    maximize.addClickHandler(new ClickHandler() {
