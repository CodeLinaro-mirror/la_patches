+//Window.alert("1 Owner Id:"+ id.get() +" Type:"+id.getType().getId());
+  }
+
+  public void displayNames(final List<Search> searches) {
+    name.clear();
+    if (searches != null) {
+
+      // Add the new searches
+      for (Search s : searches) {
+        String sname = s.getKey().get();
+        name.addItem(sname, sname);
+      }
+
+      // Select the "current search"
+      if (dSearch != null && dSearch.getSearchKey() != null) {
+        for(int i = 0; i < name.getItemCount(); i++) {
+          if (name.getValue(i).equals(dSearch.getSearchKey().get())) {
+            name.setSelectedIndex(i);
+            return;
+          }
+        }
+      }
+
+      // The search is not in the list!
+      displayNoneName();
+    }
+  }
+
+  protected void displayNoneName() {
+    // Better to insert and select a blank entry at the top of the
+    // list, than to select an existing search which does not
+    // match the "current search". Inserting a non existing
+    // search and selecting it would be deceiving, but when the
+    // type matches, a "(not found)" version of the original can be
+    // informative.
+    String none = "";
+    if (dSearch.getSearchKey().getType() == getType()) {
+      none = "(not found) "+ dSearch.getSearchKey().get();
+    }
+    name.insertItem(none, "", 0);
+    name.setSelectedIndex(0);
+  }
+
+  protected void displayName() {
+    // If a real selection is made, clean up the "none" entry
+//Window.alert("displayName Owner:"+ getOwner());
+    if (! "".equals(getOwner())) {
+//Window.alert("HERE");
+      for(int i = 0; i < name.getItemCount(); i++) {
+//Window.alert("VALUE("+i+"):"+name.getValue(i));
+        if ("".equals(name.getValue(i))) {
+          name.removeItem(i);
+          return;
+        }
+      }
+    }
+  }
+
+//  private class NamesCallback extends GerritCallback<List<Search>> {
+  private class NamesCallback implements AsyncCallback<List<Search>> {
+    private Owner.Id owner;
+
+    public NamesCallback(Owner.Id owner) {
+      this.owner = owner;
+    }
+
+    @Override
+    public void onFailure(Throwable caught) {
+      if (owner.equals(getOwnerId())) {
+        displayNames(null);
+      }
+    }
+
+    @Override
+    public final void onSuccess(final List<Search> searches) {
+//Owner.Id id = getOwnerId();
+//Window.alert("2 Owner Id:"+ id.get() +" Type:"+id.getType().getId());
+      if (owner.equals(getOwnerId())) {
+//Window.alert("HERE");
+        displayNames(searches);
+      }
+    }
+  }
+}
