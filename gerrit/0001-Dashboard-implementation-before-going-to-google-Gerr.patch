+
+public class DashScreen extends OwnerScreen {
+  protected DashList list;
+
+  protected DashTable table;
+  protected Button insert;
+
+  protected ScreenLoadCallback<DashList> cbList =
+      new ScreenLoadCallback<DashList>(this) {
+        @Override
+        protected void preDisplay(final DashList list) {
+          display(list);
+        }
+
+        @Override
+        protected void postDisplay() {
+        }
+      };
+
+  public DashScreen(final Owner.Id id) {
+    super(id);
+  }
+
+  @Override
+  protected void onInitUI() {
+    super.onInitUI();
+
+    insert = new Button(Util.C.buttonInsertNewDash());
+    insert.addClickHandler(new ClickHandler() {
+      public void onClick(ClickEvent event) {
+        insert.setVisible(false);
+        table.showEditor(-1);
+      }
+    });
+    insert.setVisible(false);
+
+    browseHeading.setText( Util.C.headingBrowseDashes());
+
+    table = new DashTable() {
+      @Override
+      protected DashEditor createDashEditor() {
+        return new Editor(null) {
+          @Override
+          public void setDash(Dash dash) {
+            super.setDash(dash);
+            if (list == null) {
+              DashScreen.this.insert.setVisible(false);
+            } else {
+              DashScreen.this.insert.setVisible(dash == null && list.isEditable());
+            }
+          }
+
+          @Override
+          public void onSaveSuccess(DashList list) {
+            super.onSaveSuccess(list);
+            DashScreen.this.display(list);
+          }
+        };
+      }
+    };
+
+    add(table);
+    add(insert);
+  }
+
+  @Override
+  protected void onLoad() {
+    super.onLoad();
+    refresh();
+  }
+
+  public void refresh() {
+    loadDashList();
+  }
+
+  public void loadDashList() {
+    Util.DASH_SVC.getDashList(ownerId, cbList);
+  }
+
+  protected void display(final DashList list) {
+    this.list = list;
+    OwnerInfo owner = list.getOwnerInfo();
+    ownerId  = owner.getId();
+    displayTitle();
+
+    String token = Dispatcher.toDashes(owner.getType(),
+       owner.getOwnerForLink());
+    setToken(token);
+
+    table.setDashList(list, null);
+    table.setSavePointerId(token);
+    table.finishDisplay();
+    table.hideEditor();
+
+    insert.setVisible(list.isEditable());
+    display();
+  }
+
+  @Override
+  public void registerKeys() {
+    super.registerKeys();
+    table.setRegisterKeys(true);
+  }
+
+  public void browse(String ownerForLink) {
+    History.newItem(Dispatcher.toDashes(ownerId.getType(), ownerForLink));
+  }
+
+  protected void displayTitle() {
+    String title = getDashTitle();
+    setPageTitle(title);
+    setWindowTitle(title);
+  }
+
+  protected String getDashTitle() {
+    String owner = list.getOwnerInfo().getOwnerForDisplay();
+    if ("".equals(owner)) {
+      switch(ownerId.getType()) {
+        case USER:    return Util.C.titleDashesUser();
+        case GROUP:   return Util.C.titleDashesGroup();
+        case PROJECT: return Util.C.titleDashesProject();
+        case SITE:    return Util.C.titleDashesSite();
+      }
+    } else {
+      switch(ownerId.getType()) {
+        case USER:    return Util.M.titleDashesUser(owner);
+        case GROUP:   return Util.M.titleDashesGroup(owner);
+        case PROJECT: return Util.M.titleDashesProject(owner);
+        case SITE:    return Util.C.titleDashesSite();
+      }
+    }
+    return "";
+  }
+}
