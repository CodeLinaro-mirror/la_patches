+package com.google.gerrit.server;
+
+import com.google.gerrit.common.errors.NoSuchEntityException;
+import com.google.gerrit.reviewdb.Dash;
+import com.google.gerrit.server.account.NoSuchGroupException;
+import com.google.gerrit.server.project.NoSuchProjectException;
+import com.google.gerrit.server.project.ProjectControl;
+import com.google.inject.Inject;
+
+/** Access control management for saved dashboards. */
+public class DashControl {
+  public static class Factory {
+    private final OwnerControl.Factory ownerControlFactory;
+
+    @Inject
+    Factory(final OwnerControl.Factory ownerControlFactory) {
+      this.ownerControlFactory = ownerControlFactory;
+    }
+
+    public DashControl controlFor(final Dash.Key key)
+        throws NoSuchEntityException, NoSuchProjectException,
+        NoSuchGroupException {
+      return new DashControl(ownerControlFactory.controlFor(key.getOwnerId()));
+    }
+
+    public DashControl controlFor(final Dash dash)
+        throws NoSuchEntityException, NoSuchProjectException,
+        NoSuchGroupException {
+      return controlFor(dash == null ? null : dash.getKey());
+    }
+
+    public DashControl validateFor(final Dash.Key key)
+        throws NoSuchEntityException, NoSuchProjectException,
+        NoSuchGroupException {
+      final DashControl c = controlFor(key);
+      if (!c.isVisible()) {
+        throw new NoSuchEntityException();
+      }
+      return c;
+    }
+
+    public DashControl validateFor(final Dash dash)
+        throws NoSuchEntityException, NoSuchProjectException,
+        NoSuchGroupException {
+      return validateFor(dash == null ? null : dash.getKey());
+    }
+  }
+
+  private OwnerControl oc;
+
+  DashControl(OwnerControl c) {
+    this.oc = c;
+  }
+
+  /** Can this user see this dash? */
+  public boolean isVisible() {
+    return oc.isVisible();
+  }
+
+  public boolean isOwner() {
+    return oc.isOwner();
+  }
+
+  public boolean canEdit() {
+    return oc.canEdit();
+  }
+}
