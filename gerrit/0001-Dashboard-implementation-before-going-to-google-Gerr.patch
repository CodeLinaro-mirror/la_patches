+package com.google.gerrit.reviewdb;
+
+import com.google.gwtorm.client.Column;
+import com.google.gwtorm.client.IntKey;
+
+public final class DashSearch {
+
+//  public static DashSearch RESTRICTED = new DashSearch();// needed on Search instead
+//  public static Key RESTRICTED_KEY = new Key(); //no, bad
+
+  /** unique identification of this DashSearch. */
+  public static class Key extends IntKey<com.google.gwtorm.client.Key<?>> {
+    @Column(id = 1)
+    protected int dashId = 0;
+
+    // 0 here indicates it is new.  Before inserting, 0 needs
+    // to be replaced with the next id from the sequence.
+    @Column(id = 2)
+    protected int id = 0;
+
+    protected Key() {
+      super();
+    }
+
+    public Key(Dash dash) {
+      super();
+      setDashId(dash.getId());
+    }
+
+    @Override
+    public int get() {
+      return id;
+    }
+
+    @Override
+    public void set(final int id) {
+      this.id = id;
+    }
+
+    public int getDashId() {
+      return dashId;
+    }
+
+    public void setDashId(final int id) {
+      this.dashId = id;
+    }
+  }
+
+  /** Unique identifier of the DashSearch  */
+  @Column(id = 1)
+  protected Key key;
+
+  @Column(id = 2)
+  protected Search.Key search;
+
+  // Position is used to create a single spaced even numbered list (0,2,4...).
+  // .To move an item in the list, simply +/-3 it, then redistribute.
+  // .To delete an item from the list, simply delete it, then redistribute.
+  @Column(id = 3)
+  protected int position = -1;  // -1 (new) put at the end
+
+  @Column(id = 4)
+  protected int max = 10;
+
+// ~ Add viewtype?
+  protected DashSearch() {
+  }
+
+  public DashSearch(final Key key) {
+    setKey(key);
+  }
+
+  public Key getKey() {
+    return key;
+  }
+
+  public void setKey(final Key key) {
+    this.key = key;
+  }
+
+  public Search.Key getSearchKey() {
+    return search;
+  }
+
+  public void setSearchKey(Search.Key search) {
+    this.search = search;
+  }
+
+  public int getPosition() {
+    return position;
+  }
+
+  public void setPosition(int pos) {
+    position = pos;
+  }
+
+  public int getMax() {
+    return max;
+  }
+
+  public void setMax(int max) {
+    this.max = max;
+  }
+
+  @Override
+  public boolean equals(final Object other) {
+    if (other instanceof DashSearch) {
+      DashSearch ds = (DashSearch) other;
+
+      if (getKey().equals(ds.getKey())) {
+        if (getSearchKey().equals(ds.getSearchKey())) {
+          if (getPosition() == ds.getPosition()) {
+            return getMax() == ds.getMax();
+          }
+        }
+      }
+    }
+    return false;
+  }
+}
