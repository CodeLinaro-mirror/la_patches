+public class DashEditor<OL extends OwnedList> extends OwnedEditor<Dash.Key,OL> {
+  private NpTextArea description;
+  private Label ownerLabel;
+  private Grid grid;
+
+  private final int nrows = 4;
+
+  private Dash dash;
+
+  private GerritCallback<OL> cb = new GerritCallback<OL>() {
+      @Override
+      public void onFailure(Throwable caught) {
+        displayButtons();
+        super.onFailure(caught);
+      }
+
+      @Override
+      public void onSuccess(OL list) {
+        onSaveSuccess(list);
+      }
+    };
+
+  public DashEditor(Dash dash) {
+    super();
+    setDash(dash);
+  }
+
+  @Override
+  public void createWidgets() {
+    super.createWidgets();
+    description = new NpTextArea();
+    ownerLabel = new Label("");
+  }
+
+  @Override
+  public void setupWidgets() {
+    name.setHintText(Util.C.defaultDashName());
+    name.setVisibleLength(45);
+    description.setWidth("99%");
+    owner.setVisibleLength(45);
+
+    save.setText(Util.C.buttonSaveDash());
+    insert.setText(Util.C.buttonInsertDash());
+    cancel.setText(Util.C.buttonCancelDash());
+
+    grid = new Grid(nrows, 2);
+
+    int r = 0, c = 0;
+    grid.setText(r++, c, Util.C.columnDashEditName());
+    grid.setText(r++, c, Util.C.columnDashEditDescription());
+    grid.setText(r++, c, Util.C.columnDashEditType());
+    grid.setWidget(r++, c, ownerLabel);
+
+    r = 0; c++;
+    grid.setWidget(r++, c, name);
+    grid.setWidget(r++, c, description);
+    grid.setWidget(r++, c, type);
+    grid.setWidget(r++, c, ownerSug);
+
+    final FlowPanel buttons = new FlowPanel();
+    buttons.add(save);
+    buttons.add(insert);
+    buttons.add(cancel);
+
+    final FlowPanel fp = new FlowPanel();
+    fp.add(grid);
+    fp.add(buttons);
+    setWidget(fp);
+  }
+
+  @Override
+  public void setupSaveEnablers() {
+    super.setupSaveEnablers();
+    enabler.listenTo(description);
+  }
+
+  public Dash getDash() {
+    return dash;
+  }
+
+  public void setDash(Dash dash) {
+    this.dash = dash;
+    description.setText(dash == null ? "" : dash.getDescription());
+    setOwnedKey(dash == null ? null : dash.getKey());
+  }
+
+  @Override
+  public Dash.Key getOwnedKey() {
+    return new Dash.Key(getOwnerId(), name.getText());
+  }
+
+  @Override
+  protected void displayOwnerType(String txt) {
+    super.displayOwnerType(txt);
+    ownerLabel.setText(txt);
+    ownerLabel.setVisible(! "".equals(txt));
+  }
+
+  @Override
+  public boolean isChangedOther() {
+    return super.isChangedOther() ||
+      ! description.getText().equals(getDash().getDescription());
+  }
+
+  @Override
+  public void onSave(boolean insert) {
+    super.onSave(insert);
+
+    Dash dash = getDash();
+    dash.setKey(getOwnedKey());
+    dash.setDescription(description.getText());
+
+    if (insert) {
+      dash.setId(0);
+    }
+    onSave(dash, cb);
+  }
+
+  public void onSave(Dash dash, GerritCallback<OL> cb) {
+  }
+
+  public void onSaveSuccess(OL list) {
+    setDash(null);
+  }
+
+  @Override
+  public void onCancel() {
+    setDash(null);
+  }
+}
