+package com.google.gerrit.common.data;
+
+import com.google.gerrit.reviewdb.Dash;
+import com.google.gerrit.reviewdb.DashSearch;
+import com.google.gerrit.reviewdb.Owner;
+import com.google.gerrit.reviewdb.Search;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Summary information about a {@link Dash}. */
+public class DashInfo extends OwnedList {
+  private Dash dash;
+  private List<DashSearch> dSearches = new ArrayList<DashSearch>(0);
+  private Map<Search.Key,Search> searches = new HashMap<Search.Key,Search>(0);
+  private Map<Owner.Id,OwnerInfo> ownerInfoFor =
+    new HashMap<Owner.Id,OwnerInfo>();
+
+  protected DashInfo() {
+    super();
+  }
+
+  public DashInfo(Dash dash, OwnerInfo ownerInfo) {
+    super(ownerInfo);
+    setDash(dash);
+  }
+
+  public Dash getDash() {
+    return dash;
+  }
+
+  public void setDash(Dash dash) {
+    this.dash = dash;
+  }
+
+  public List<DashSearch> getDashSearches() {
+    return dSearches;
+  }
+
+  public void setDashSearches(List<DashSearch> dSearches) {
+    this.dSearches = dSearches;
+  }
+
+  public Map<Search.Key,Search> getSearches() {
+    return searches;
+  }
+
+  public void setSearches(Map<Search.Key,Search> searches) {
+    this.searches = searches;
+  }
+
+  public Map<Owner.Id,OwnerInfo> getOwnerInfoFor() {
+    return ownerInfoFor;
+  }
+}
