diff --git a/gerrit-gwtui/src/main/java/com/google/gerrit/client/ui/SplitList.java b/gerrit-gwtui/src/main/java/com/google/gerrit/client/ui/SplitList.java
new file mode 100644
index 0000000..2d83b54
--- /dev/null
+++ b/gerrit-gwtui/src/main/java/com/google/gerrit/client/ui/SplitList.java
@@ -0,0 +1,346 @@
+// Copyright (C) 2011 The Android Open Source Project
+// Copyright (c) 2011, Code Aurora Forum. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
