+        onMinimize(false);
+      }
+    });
+
+    edit = new Button(Util.C.buttonEditDashSearch());
+    edit.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        setButtonsEnabled(false);
+        editQuery();
+      }
+    });
+
+    up = new Button("&#x21e7;");
+    up.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        setButtonsEnabled(false);
+        onUp();
+      }
+    });
+
+    down = new Button("&#x21e9;");
+    down.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        setButtonsEnabled(false);
+        onDown();
+      }
+    });
+
+    delete = new Button(Util.C.buttonDeleteDashSearch());
+    delete.addClickHandler(new ClickHandler() {
+      @Override
+      public void onClick(final ClickEvent event) {
+        onConfirmDelete();
+      }
+    });
+
+    confirm = new Confirm();
+    confirm.setVisible(false);
+
+    grid = new Grid(1, 8);
+    grid.setStyleName(Gerrit.RESOURCES.css().infoBlock());
+    grid.setWidget(0, 0, minimize);
+
+    setDashSearch(dSearch);
+
+    int c = 3;
+    grid.setWidget(0, c++, maxcount);
+    if (info.isEditable()) {
+// ~ right justify
+      grid.setWidget(0, c++, up);
+      grid.setWidget(0, c++, down);
+      grid.setWidget(0, c++, edit);
+      grid.setWidget(0, c++, delete);
+    }
+
+    outter = new Grid(2, 1);
+    outter.setWidget(0, 0, grid);
+    outter.setWidget(1, 0, confirm);
+    setWidget(outter);
+  }
+
+  public void setDashSearch(DashSearch ds) {
+    dSearch = ds;
+    String query = "(Undefined)";
+    try {
+      Search.Key key = ds.getSearchKey();
+      OwnerInfo owner = null;
+      String link = null;
+
+      if (key == null) {
+        query = "(Undefined Search Key)";
+      } else if (key.get() == null) {
+        query = "(Undefined Search)";
+      } else if (info == null) {
+        query = "(Undefined Search Owner Info):" + key.get();
+      } else if (info.getOwnerInfoFor() == null) {
+        query = "(Undefined Search Owner Info For):" + key.get();
+      } else {
+        owner = info.getOwnerInfoFor().get(key.getOwnerId());
+        if (owner == null) {
+          query = "(Undefined Search Owner):" + key.get();
+        } else  {
+          query = Util.getQuery(key, owner);
+          link = "q," + query + ",n,z";
+          grid.setWidget(0, 1, new Hyperlink(query, link));
+
+          Search search = info.getSearches().get(key);
+          grid.setText(0, 2, search.getDescription());
+          return;
+        }
+      }
+    } catch (Exception e) {
+      grid.setWidget(0, 1, new Label(query));
+    }
+  }
+
+  public void setButtonsEnabled(boolean enabled) {
+    edit.setEnabled(enabled);
+    delete.setEnabled(enabled);
+    up.setEnabled(enabled);
+    down.setEnabled(enabled);
+  }
+
+  public void setTop(boolean top) {
+    up.setVisible(! top);
+  }
+
+  public void setBottom(boolean bot) {
+    down.setVisible(! bot);
+  }
+
+  public void setCount(int count) {
+    maxcount.setText("(" + count + "/" + dSearch.getMax() + ")");
+  }
+
+  public void editQuery() {
+  }
+
+  public void onUp() {
+  }
+
+  public void onDown() {
+  }
+
+  public void onDelete() {
+  }
+
+  public void onConfirmDelete() {
+    setButtonsEnabled(false);
+    confirm.setVisible(true);
+  }
+
+  public void onCancelDelete() {
+    confirm.setVisible(false);
+    setButtonsEnabled(true);
+  }
+
+  public void onMinimize(boolean min) {
+    grid.setWidget(0, 0, min ? maximize : minimize);
+  }
+}
