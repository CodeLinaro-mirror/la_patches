+import com.google.gerrit.reviewdb.Dash;
+import com.google.gerrit.reviewdb.DashSearch;
+import com.google.gerrit.reviewdb.Owner;
+import com.google.gerrit.reviewdb.ReviewDb;
+import com.google.gerrit.reviewdb.Search;
+import com.google.gerrit.server.DashControl;
+import com.google.gerrit.server.IdentifiedUser;
+import com.google.gerrit.server.OwnerControl;
+import com.google.gerrit.server.OwnerUtil;
+import com.google.gerrit.server.account.NoSuchGroupException;
+import com.google.gerrit.server.project.NoSuchProjectException;
+import com.google.gerrit.server.query.SearchControl;
+import com.google.gwt.user.client.rpc.AsyncCallback;
+import com.google.gwtjsonrpc.client.VoidResult;
+import com.google.gwtorm.client.OrmDuplicateKeyException;
+import com.google.gwtorm.client.OrmException;
+import com.google.inject.Inject;
+import com.google.inject.Provider;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public class DashServiceImpl extends OwnerBaseServiceImplementation implements
+    DashService {
+
+  private final Provider<IdentifiedUser> currentUser;
+  private final DashControl.Factory dashControlFactory;
+  private final SearchControl.Factory searchControlFactory;
+  private final ChangeListServiceImpl changeListService;
+
+  private static final AsyncCallback<VoidResult> NULL_CALLBACK =
+      new AsyncCallback<VoidResult>() {
+        @Override
+        public void onFailure(Throwable caught) {
+        }
+
+        @Override
+        public void onSuccess(VoidResult result) {
+        }
+      };
+
+  @Inject
+  DashServiceImpl(final Provider<ReviewDb> schema,
+      final Provider<IdentifiedUser> currentUser,
+      final OwnerUtil ownerUtil,
+      final OwnerControl.Factory ownerControlFactory,
+      final DashControl.Factory dashControlFactory,
+      final SearchControl.Factory searchControlFactory,
+      final ChangeListServiceImpl changeListService) {
+    super(schema, currentUser, ownerControlFactory, ownerUtil);
+    this.currentUser = currentUser;
+    this.dashControlFactory = dashControlFactory;
+    this.searchControlFactory = searchControlFactory;
+    this.changeListService = changeListService;
+  }
+
+// fix synchronizeds
+
+  @Override
+  public void getDashInfo(final Dash.Key key,
+      final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        resolveOwner(key);
+        validateDashControlFor(key, dashControlFactory);
+        return getDashInfo(db, key);
+      }
+    });
+  }
+
+  @Override
+  public void getDashes(final Owner.Id id,
+      final AsyncCallback<List<Dash>> callback) {
+    run(callback, new Action<List<Dash>>() {
+      public List<Dash> run(final ReviewDb db)
+          throws OrmException, Failure {
+        return visibleFor(db, id);
+      }
+    });
+  }
+
+  @Override
+  public void getDashList(final Owner.Id id,
+      final AsyncCallback<DashList> callback) {
+    run(callback, new Action<DashList>() {
+      public DashList run(final ReviewDb db) throws OrmException, Failure {
+        return getDashList(db, id);
+      }
+    });
+  }
+
+  @Override
+  public void deleteDash(final int id,
+      final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        if (! isLoggedIn()) {
+          throw new Failure(new Exception("You must be logged in to delete a dashboard"));
+        }
+
+        Dash dash = getDash(db, id);
+        if (dash == null) {
+          throw new Failure(new Exception("Dashboard not found"));
+        }
+
+        DashControl c = validateDashControlFor(dash, dashControlFactory);
+        if (!c.canEdit()) {
+          throw new Failure(new Exception("Permission denied deleting dashboard"));
+        }
+
+        if (getOrderedDashSearches(db, dash.getId()).size() != 0) {
+          throw new Failure(new Exception("Cannot delete a non empty dashboard"));
+        }
+
+        db.dashes().delete(Collections.singleton(dash));
+        dash.setId(0);
+        return getDashInfo(db, dash);
+      }
+    });
+  }
+
+  @Override
+  public void saveDashL(final Dash dash,
+      final AsyncCallback<DashList> callback) {
+    run(callback, new Action<DashList>() {
+      public DashList run(final ReviewDb db) throws OrmException, Failure {
+        return getDashList(db, saveDash(db, dash).getKey().getOwnerId());
+      }
+    });
+  }
+
+  @Override
+  public void saveDashI(final Dash dash,
+      final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        return getDashInfo(db, saveDash(db, dash));
+      }
+    });
+  }
+
+  @Override
+  public void saveDashSearch(final DashSearch dSearch, final Dash.Key key,
+    final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        if (! isLoggedIn()) {
+          throw new Failure(new Exception("You must be logged in to edit a dashboard"));
+        }
+
+        Dash dash = createOrEditDash(db, dSearch, key);
+        resolveSearchOwner(dSearch);
+
+        // Since a DashSearch pointing to a Search which is offlimits
+        // behaves differently in a Dashboard display from a non
+        // existant search, it needs to be impossible to insert
+        // a pointer to a non existant search.  This is to ensure
+        // that insertion cannot be used to figure out the names
+        // to existing but offlimit Searches.
+        //
+        // Note: it is however OK if other events such as deleting
+        // a Search, creates non-existing searches.  This method
+        // of creation cannot be used by an attacker to deduce
+        // the existance of a specificaly named Search.
+
+        SearchControl sc = null;
+        try {
+          sc =  SearchServiceImpl.validateSearchControlFor(
+            dSearch.getSearchKey(), searchControlFactory);
+        } catch(Exception e) {
+        }
+        if (db.searches().get(dSearch.getSearchKey()) == null) {
+          sc = null;
+        }
+        if (sc == null) {
+          throw new Failure(new Exception("Dash Search not found"));
+        }
+
+        if (dSearch.getKey().get() == 0) {
+          dSearch.getKey().set(db.nextDashSearchId());
+          db.dashSearches().insert(Collections.singleton(dSearch));
+        } else {
+          db.dashSearches().update(Collections.singleton(dSearch));
+        }
+        return getDashInfo(db, dash);
+      }
+    });
+  }
+
+  @Override
+  public synchronized void moveDashSearch(final DashSearch.Key key,
+      final boolean up, final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        if (! isLoggedIn()) {
+          throw new Failure(new Exception("You must be logged in to edit a dashboard"));
+        }
+
+        Dash dash = getDash(db, key.getDashId());
+        final DashControl c = validateDashControlFor(dash, dashControlFactory);
+        if (!c.canEdit()) {
+           throw new Failure(new Exception("Permission denied editing dashboard"));
+        }
+
+        // Ensure all even numbered positions
+        List<DashSearch> dSearches = getOrderedDashSearches(db, dash.getId());
+        for (int i = 0; i < dSearches.size(); i++) {
+          DashSearch ds = dSearches.get(i);
+          if (ds.getKey().equals(key)) {
+            if (up) {
+              if (i < 1) { // up: no dsearches above
+                break;
+              }
+              // To avoid going negative, always add to a search's
+              // position.  Move the previous search down instead.
+              ds = dSearches.get(i - 1);
+            } else if (i >= dSearches.size()) { // down: no dsearches below
+              break;
+            }
+
+            // Move to an odd numbered position to avoid collisions,
+            // leapfrog the next position (which is +2)
+            ds.setPosition(ds.getPosition() + 3);
+            db.dashSearches().update(Collections.singleton(ds));
+            break;
+          }
+        }
+
+        // Redistribute positions
+        return getDashInfo(db, dash);
+      }
+    });
+  }
+
+  @Override
+  public synchronized void deleteDashSearches(final Set<DashSearch.Key> keys,
+      final AsyncCallback<DashInfo> callback) {
+    run(callback, new Action<DashInfo>() {
+      public DashInfo run(final ReviewDb db) throws OrmException, Failure {
+        if (! isLoggedIn()) {
+          throw new Failure(new Exception("You must be logged in to delete a dash search"));
+        }
+
+        Dash dash = null;
+        for (DashSearch.Key dskey : keys) {
+          dash = getDash(db, dskey.getDashId());
+          final DashControl c = validateDashControlFor(dash, dashControlFactory);
+          if (!c.canEdit()) {
+            throw new Failure(new Exception("Permission denied deleting dash search"));
+          }
+          final DashSearch dSearch = db.dashSearches().byKey(dskey);
+          db.dashSearches().delete(Collections.singleton(dSearch));
+        }
+
+        if (dash != null) {
+          // Redistribute positions (eliminate gap to allow moves to work)
+          return getDashInfo(db, dash);
+        }
+        return null;
+      }
+    });
+  }
+
+  private Dash createOrEditDash(final ReviewDb db, DashSearch dSearch,
+      Dash.Key key) throws OrmException, Failure {
+    Dash dash = createOrEditDash(db, dSearch.getKey().getDashId(), key);
+    dSearch.getKey().setDashId(dash.getId());
+    return dash;
+  }
+
+  private Dash createOrEditDash(final ReviewDb db, int dashId, Dash.Key key)
+      throws OrmException, Failure {
+    Dash dash;
+    if (dashId == 0) {
+      resolveOwner(key);
+      dash = new Dash(key, db.nextDashId());
+    } else {
+      dash = getDash(db, dashId);
+    }
+
+    final DashControl c = validateDashControlFor(dash, dashControlFactory);
+    if (!c.canEdit()) {
+        throw new Failure(new Exception("Permission denied editing dashboard"));
+    }
+
+    if (dashId == 0) {
+      db.dashes().insert(Collections.singleton(dash));
+    }
+    return dash;
+  }
+
+  private Dash getDash(final ReviewDb db, final int id) throws OrmException,
+      Failure {
+    List<Dash> dashes = db.dashes().byId(id).toList();
+    if (dashes.size() > 0) {
+      if (dashes.size() > 1) {
+        // remove duplicates from db > 0
+      }
+      return dashes.get(0);
+    }
+    return null;
+  }
+
+  public DashList getDashList(final ReviewDb db, final Owner.Id id)
+      throws OrmException, Failure {
+    DashList list = new DashList(new OwnerInfo(id.getType()));
+
+    if (! "".equals(id.get())) {
+      IdentifiedUser user = null;
+      if (isLoggedIn()) {
+        user = currentUser.get();
+      }
+      list.setOwnerInfo(getOwnerInfo(id));
+    } else if (id.getType() == Owner.Type.USER && isLoggedIn()) {
+      list.setOwnerInfo(new OwnerInfo(currentUser.get().getAccount()));
+    } else if (id.getType() != Owner.Type.SITE) {
+      return list;
+    }
+
+    try {
+      list.setEditable(validateOwnerControlFor(list.getOwnerInfo().getId())
+        .canEdit());
+    } catch (Exception e) {
+      throw new Failure(e);
+    }
+    list.setDashes(visibleFor(db, list.getOwnerInfo().getId()));
+    return list;
+  }
+
+  private DashInfo getDashInfo(final ReviewDb db, final Dash.Key key)
+      throws OrmException, Failure {
+    Dash dash = db.dashes().byKey(key);
+    if (dash == null) {
+      dash = new Dash(key);
+    }
+    return getDashInfo(db, dash);
+  }
+
+  private DashInfo getDashInfo(final ReviewDb db, final Dash dash)
+      throws OrmException, Failure {
+    Owner.Id id = dash.getKey().getOwnerId();
+    DashInfo info = new DashInfo(dash, new OwnerInfo(id.getType()));
+
+    if (! "".equals(id.get())) {
+      info.setOwnerInfo(getOwnerInfo(id));
+    } else if (id.getType() == Owner.Type.USER && isLoggedIn()) {
+      info.setOwnerInfo(new OwnerInfo(currentUser.get().getAccount()));
+    } else if (id.getType() != Owner.Type.SITE) {
+      return info;
+    }
+
+    try {
+      info.setEditable(validateDashControlFor(dash, dashControlFactory).canEdit());
+    } catch (Exception e) {
+      throw new Failure(e);
+    }
+
+    id = info.getOwnerInfo().getId();
+    info.getOwnerInfoFor().put(id, info.getOwnerInfo());
+
+    fillSearchInfo(db, info);
+    return info;
+  }
+
+  private void fillSearchInfo(final ReviewDb db, final DashInfo info)
+      throws OrmException, Failure {
+    if (info.getDash().getId() == 0) {
+      return;
+    }
+
+    info.setDashSearches(getOrderedDashSearches(db, info.getDash().getId()));
+
+    final Map<Search.Key,Search> searches = info.getSearches();
+    for(DashSearch ds : info.getDashSearches()) {
+      final Search.Key skey = ds.getSearchKey();
+      try {
+        SearchControl c = SearchServiceImpl.validateSearchControlFor(skey,
+          searchControlFactory);
+      } catch (Exception e) {
+        // If the user does not have permission to see this search,
+        // a dummy blank search should be inserted in the list.
+        // This dummy needs to be treated as uneditable, but it
+        // must be moveable and deleteable (afterall, that is why
+        // we bother inserting the dummy).
+      }
+
+      final Owner.Id soid = skey.getOwnerId();
+      if (! info.getOwnerInfoFor().containsKey(soid)) {
+        info.getOwnerInfoFor().put(soid, getOwnerInfo(soid));
+      }
+      searches.put(ds.getSearchKey(), db.searches().get(skey));
+    }
+  }
+
+  private List<DashSearch> getOrderedDashSearches(final ReviewDb db,
+      final Dash.Key dash) throws OrmException, Failure {
+    Dash d = db.dashes().byKey(dash);
+    if (d == null) { return new ArrayList<DashSearch>(0); }
+    return getOrderedDashSearches(db, d.getId());
+  }
+
+  private List<DashSearch> getOrderedDashSearches(final ReviewDb db,
+      final int dashId) throws OrmException, Failure {
+    final List<DashSearch> dSearches = db.dashSearches().byDash(dashId).toList();
+
+    Collections.sort(dSearches, new Comparator<DashSearch>() {
+        public int compare(DashSearch ds1, DashSearch ds2) {
+          if (ds1.getPosition() > ds2.getPosition()) {
+            return 1;
+          }
+          if (ds1.getPosition() < ds2.getPosition()) {
+            return -1;
+          }
+          return 0;
+        }
+        public boolean equals(DashSearch ds) {
+          return this.equals(ds);
+        }
+      });
+
+    // These are new and have not been positioned yet
+    final List<DashSearch> negative = new ArrayList<DashSearch>(0);
+    for (int i = 0; i < dSearches.size(); i++) {
+      final DashSearch s = dSearches.get(i);
+      if (s.getPosition() < 0) {
+        negative.add(s);
+        dSearches.remove(i);
+        i--;
+      }
+    }
+
+    // Redistribute all to even numbered single spaced positions
+    // A gap would prevent +/-3 from moving a dSearch in the
+    // ordered list.
+    for (int i = 0; i < dSearches.size(); i++) {
+      int pos = i * 2;
+      final DashSearch ds = dSearches.get(i);
+      if (ds.getPosition() > pos) {
+        ds.setPosition(pos);
+        db.dashSearches().update(Collections.singleton(ds));
+      }
+    }
+    for (int i = dSearches.size() -1 ; i >= 0; i--) {
+      int pos = i * 2;
+      final DashSearch ds = dSearches.get(i);
+      if (ds.getPosition() < pos) {
+        ds.setPosition(pos);
+        db.dashSearches().update(Collections.singleton(ds));
+      }
+    }
+
+    // New ones go to the end
+    for (int i = 0; i < negative.size(); i++) {
+      final DashSearch ds = negative.get(i);
+      ds.setPosition(2 * dSearches.size());
+      dSearches.add(ds);
+      db.dashSearches().update(Collections.singleton(ds));
+    }
+
+    return dSearches;
+  }
+
+  private Dash saveDash(final ReviewDb db, final Dash dash)
+      throws OrmException, Failure {
+    if (! isLoggedIn()) {
+      throw new Failure(new Exception("You must be logged in to saving a dashboard"));
+    }
+
+    resolveOwner(dash);
+    DashControl c = validateDashControlFor(dash, dashControlFactory);
+    if (!c.canEdit()) {
+      throw new Failure(new Exception("Permission denied saving dashboard"));
+    }
+
+    Dash src = null;
+    if (dash.getId() != 0) {
+      src = getDash(db, dash.getId());
+    }
+
+    if (src == null) {
+      dash.setId(db.nextDashId());
+
+      if (! "".equals(dash.getKey().get())) {
+        db.dashes().insert(Collections.singleton(dash));
+      } else {
+        for (int n = 0; true; n++) {
+          try {
+            dash.getKey().set("Untitled" + (n == 0 ? "" : n));
+            db.dashes().insert(Collections.singleton(dash));
+            break;
+          } catch (OrmDuplicateKeyException e) {}
+        }
+      }
+
+    } else if (src.getKey().equals(dash.getKey())) {
+      db.dashes().update(Collections.singleton(dash));
+
+    } else {
+      // cannot modify primary key, need to create a new entry
+      c = validateDashControlFor(src, dashControlFactory);
+      if (!c.canEdit()) {
+        throw new Failure(new Exception("Permission denied renaming dashboard"));
+      }
+      db.dashes().insert(Collections.singleton(dash));
+
+      // If interrupted we will have a duplicate entry
+      // for this ID, when detected, simply delete either,
+      // which will either roll back or forward, it is not
+      // important which way.
+      db.dashes().delete(Collections.singleton(src));
+    }
+    return dash;
+  }
+
+  private List<Dash> visibleFor(final ReviewDb db, final Owner.Id id)
+      throws OrmException, Failure {
+    validateOwnerControlFor(id);
+    List<Dash> dashes = db.dashes().byOwner(id.getType().getCode(), id.get()).toList();
+    List<Dash> visible = new ArrayList<Dash>(dashes.size());
+    for (Dash d : dashes) {
+      try {
+        DashControl c = dashControlFactory.validateFor(d);
+        if (c.isVisible()) {
+          visible.add(d);
+        }
+      } catch (Exception e) {}
+    }
+    return visible;
+  }
+
+  public void resolveSearchOwner(final DashSearch dSearch)
+      throws OrmException, Failure {
+    Owner.Id id = dSearch.getSearchKey().getOwnerId();
+    OwnerInfo owner = getOwnerInfo(id);
+    dSearch.getSearchKey().setOwnerId(owner.getId());
+  }
+
+  public void resolveOwner(final Dash dash)
+      throws OrmException, Failure {
+    resolveOwner(dash.getKey());
+  }
+
+  public void resolveOwner(final Dash.Key key)
+      throws OrmException, Failure {
+    Owner.Id id = key.getOwnerId();
+    OwnerInfo owner = getOwnerInfo(id);
+    key.setOwnerId(owner.getId());
+  }
+
+  public static DashControl validateDashControlFor(Dash.Key key,
+      DashControl.Factory factory) throws Failure {
+    try {
+      return factory.validateFor(key);
+    } catch (NoSuchEntityException e) {
+      throw new Failure(e);
+    } catch (NoSuchGroupException e) {
+      throw new Failure(e);
+    } catch (NoSuchProjectException e) {
+      throw new Failure(e);
+    }
+  }
+
+  public static DashControl validateDashControlFor(Dash dash,
+      DashControl.Factory factory) throws Failure {
+    try {
+      return factory.validateFor(dash);
+    } catch (NoSuchEntityException e) {
+      throw new Failure(e);
+    } catch (NoSuchGroupException e) {
+      throw new Failure(e);
+    } catch (NoSuchProjectException e) {
+      throw new Failure(e);
+    }
+  }
+}
