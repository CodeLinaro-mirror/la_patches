+        break;
+      case GROUP:   oracle.setIndex(1);
+        break;
+      case PROJECT: oracle.setIndex(2);
+        break;
+      case SITE:
+          grid.setText(r_owner, 0, "");
+          grid.setText(r_owner, 1, "");
+        break;
+    }
+
+    if (dSearch.getSearchKey().getType() == getType()) {
+      owner.setText(getOwnerForDisplay());
+    }
+
+/*    if (oldsearch != null && getOwnerForDisplay().equals(owner.getText())) {
+        owner.setText("");
+      } */
+  }
