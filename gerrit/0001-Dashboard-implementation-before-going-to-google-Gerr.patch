+try {
+      editor = new DashSearchEditor2(info, dSearch) {
+          @Override
+          public void onSaveSuccess(DashInfo info) {
+            displayBar(dSearch);
+            DashChangeTable.this.display(info);
+          }
+
+          @Override
+          public void onCancel() {
+            if (dSearch.getKey().get() == 0) {
+              DashSection.this.detach();
+              DashChangeTable.this.setButtonsEnabled(true);
+            } else {
+              displayBar(dSearch);
+            }
+          }
+
+          public void displayBar(DashSearch dSearch) {
+            DashSection.this.setDashSearch(dSearch);
+            DashSection.this.displayBar();
+          }
+        };
+} catch (Exception e) {Window.alert("C\n"+e);}
+
+try {
+      bar = new DashSearchBar(dSearch, info) {
+          @Override
+          public void editQuery() {
+            displayEditor();
+          }
+
+          @Override
+          public void onUp() {
+            DashChangeTable.this.setButtonsEnabled(false);
+            Util.DASH_SVC.moveDashSearch(dSearch.getKey(), true, cbDashInfo);
+          }
+
+          @Override
+          public void onDown() {
+            DashChangeTable.this.setButtonsEnabled(false);
+            Util.DASH_SVC.moveDashSearch(dSearch.getKey(), false, cbDashInfo);
+          }
+
+          @Override
+          public void onMinimize(boolean min) {
+            data.setVisible(! min);
+            super.onMinimize(min);
+          }
+
+          @Override
+          public void onConfirmDelete() {
+            DashChangeTable.this.setButtonsEnabled(false);
+            wasOpen = data.isVisible();
+            data.setVisible(false);
+            super.onConfirmDelete();
+          }
+
+          @Override
+          public void onCancelDelete() {
+            super.onCancelDelete();
+            data.setVisible(wasOpen);
+            DashChangeTable.this.setButtonsEnabled(true);
+          }
+
+          @Override
+          public void onDelete() {
+            DashChangeTable.this.setButtonsEnabled(false);
+            detach();
+            Util.DASH_SVC.deleteDashSearches(
+              Collections.singleton(dSearch.getKey()), cbDashInfo);
+          }
+        };
+
+} catch (Exception e) {Window.alert("D\n"+e);}
+
+try {
