+
+import java.util.List;
+
+public class DashBoard extends Screen {
+  private DashInfo info;
+
+  private DashChangeTable table;
+  private DashEditor<DashInfo> editor;
+  private Button insert;
+  private Button edit;
+  private Button delete;
+
+  public DashBoard(final Dash.Key key) {
+    super();
+    info = new DashInfo(new Dash(key), null);
+  }
+
+  @Override
+  protected void onInitUI() {
+    super.onInitUI();
+
+    table = new DashChangeTable(info.getDash().getKey()) {
+      @Override
+      protected void display(final DashInfo info) {
+        super.display(info);
+        DashBoard.this.display(info);
+      }
+
+      @Override
+      public void setButtonsEnabled(boolean enabled) {
+        super.setButtonsEnabled(enabled);
+        insert.setEnabled(enabled);
+        if (enabled && info != null) {
+          insert.setVisible(info.isEditable());
+        }
+        edit.setEnabled(enabled);
+        delete.setEnabled(enabled);
+      }
+    };
+
+    editor = new DashEditor<DashInfo>(null) {
+      @Override
+      public void onSave(final Dash dash, final GerritCallback<DashInfo> cb) {
+        Util.DASH_SVC.saveDashI(dash, cb);
+      }
+
+      @Override
+      public void onSaveSuccess(DashInfo info) {
+        super.onSaveSuccess(info);
+        display(info);
+      }
+
+      @Override
+      public void onCancel() {
+        displayEditing(false);
+        super.onCancel();
+      }
+    }; // ~ make green somehow
+    editor.setVisible(false);
+
+    insert = new Button(Util.C.buttonInsertNewDashSearch());
+    insert.addClickHandler(new ClickHandler() {
+      public void onClick(ClickEvent event) {
+        table.setButtonsEnabled(false);
+        insert.setVisible(false);
+        final DashSearch ds = new DashSearch(new DashSearch.Key(info.getDash()));
+        final DashChangeTable.DashSection section = table.new DashSection(ds);
+        section.attach();
+        section.displayEditor();
+      }
+    });
+    insert.setVisible(false);
+
+    edit = new Button(Util.C.buttonEditDash());
+    edit.addClickHandler(new ClickHandler() {
+      public void onClick(ClickEvent event) {
+        editor.setOwnedList(info);
+        editor.setDash(info.getDash());
+        displayEditing(true);
+      }
+    });
+    edit.setVisible(false);
+
+    delete = new Button(Util.C.buttonDeleteDash());
+    delete.addClickHandler(new ClickHandler() {
+      public void onClick(ClickEvent event) {
+        table.setButtonsEnabled(false);
+        Util.DASH_SVC.deleteDash(info.getDash().getId(), table.cbDashInfo);
+      }
+    });
+    delete.setVisible(false);
+
+    add(table);
+    add(editor);
+
+    add(insert);
+    add(edit);
+    add(delete);
+  }
+
+  @Override
+  protected void onLoad() {
+    super.onLoad();
+    table.loadDash();
+  }
+
+  @Override
+  public void registerKeys() {
+    super.registerKeys();
+    table.setRegisterKeys(true);
+  }
+
+  protected void display(final DashInfo info) {
+    this.info = info;
+
+    OwnerInfo owner = info.getOwnerInfo();
+    String token = Dispatcher.toDash(owner.getType(), owner.getOwnerForLink(),
+      info.getDash().getKey().get());
+
+    setToken(token);
+    table.setSavePointerId(token);
+
+    displayTitle(info);
+    displayEditing(false);
+    display();
+  }
+
+  protected void displayEditing(boolean editing) {
+    if (editing) {
+      insert.setVisible(false);
+      edit.setVisible(false);
+      delete.setVisible(false);
+    } else {
+      insert.setVisible(info.isEditable());
+      edit.setVisible(info.isEditable());
+      delete.setVisible(info.isEditable() && info.getDashSearches().size() == 0
+        && info.getDash().getId() != 0);
+    }
+    editor.setVisible(editing);
+    table.setButtonsEnabled(! editing);
+  }
+
+  protected void displayTitle(final DashInfo info) {
+    String title = getDashTitle(info);
+    String desc = info.getDash().getDescription();
+    if (desc != null) {
+      setPageTitle(desc + "  [" + title + "]");
+      setWindowTitle(desc);
+    } else {
+      setPageTitle(title);
+      setWindowTitle(title);
+    }
+  }
+
+  protected String getDashTitle(final DashInfo info) {
+//~ add/use description
+    String state = "";
+    if (info.getDash().getId() == 0) {
+      state = " (new/unsaved)";
+    }
+
+    Dash.Key dKey = info.getDash().getKey();
+    String name = dKey.get();
+    String owner =  dKey.getOwner();
+    if (info != null) {
+      owner = info.getOwnerInfo().getOwnerForDisplay();
+    }
+    if ("".equals(owner)) {
+      switch(dKey.getType()) {
+        case USER:    return Util.C.titleDashesUser() + state;
+        case GROUP:   return Util.C.titleDashesGroup() + state;
+        case PROJECT: return Util.C.titleDashesProject() + state;
+        case SITE:    return Util.C.titleDashesSite() + state;
+      }
+    } else if ("".equals(name)) {
+      switch(dKey.getType()) {
+        case USER:    return Util.M.titleDashesUser(owner) + state;
+        case GROUP:   return Util.M.titleDashesGroup(owner) + state;
+        case PROJECT: return Util.M.titleDashesProject(owner) + state;
+        case SITE:    return Util.C.titleDashesSite() + state;
+      }
+    } else {
+      switch(dKey.getType()) {
+        case USER:    return Util.M.titleDashUser(owner, name) + state;
+        case GROUP:   return Util.M.titleDashGroup(owner, name) + state;
+        case PROJECT: return Util.M.titleDashProject(owner, name) + state;
+        case SITE:    return Util.M.titleDashSite(name) + state;
+      }
+    }
+    return state;
+  }
+}
