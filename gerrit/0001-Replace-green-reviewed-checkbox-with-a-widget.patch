@@ -273,9 +273,8 @@ public abstract class PatchScreen extends Screen implements
   void setReviewedByCurrentUser(boolean reviewed) {
     if (fileList != null) {
       fileList.updateReviewedStatus(patchKey, reviewed);
-    }
-
-    PatchUtil.DETAIL_SVC.setReviewedByCurrentUser(patchKey, reviewed,
+    } else {
+      PatchUtil.DETAIL_SVC.setReviewedByCurrentUser(patchKey, reviewed,
         new AsyncCallback<VoidResult>() {
           @Override
           public void onFailure(Throwable arg0) {
@@ -287,6 +286,7 @@ public abstract class PatchScreen extends Screen implements
             // nop
           }
         });
+    }
   }
 
   @Override
