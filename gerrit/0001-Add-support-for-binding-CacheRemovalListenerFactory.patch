+package com.google.gerrit.server.cache.h2;
+
+import com.google.common.cache.RemovalListener;
+
+public abstract class CacheRemovalListener<K, V> implements
+    RemovalListener<K, V> {
+  protected String pluginName;
+  protected String cacheName;
+
+  public CacheRemovalListener(String pluginName, String cacheName) {
+    this.pluginName = (pluginName == null) ? "gerrit" : pluginName;
+    this.cacheName = cacheName;
+  }
+}
