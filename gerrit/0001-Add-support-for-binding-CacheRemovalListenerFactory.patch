+package com.google.gerrit.server.cache.h2;
+
+import com.google.gerrit.extensions.annotations.PluginName;
+import com.google.gerrit.extensions.registration.DynamicSet;
+import com.google.inject.Inject;
+
+/**
+ * Creates instances of MasterRemovalListers. This is required since
+ * RemovalListers take generic arguments from the creating method.
+ *
+ */
+public class MasterRemovalListenerFactory {
+  private DynamicSet<CacheRemovalListenerFactory> listenerFactories;
+  private String pluginName;
+
+  @Inject
+  public MasterRemovalListenerFactory(
+      DynamicSet<CacheRemovalListenerFactory> listenerFactories) {
+    this.listenerFactories = listenerFactories;
+  }
+
+  @Inject(optional = true)
+  void setPluginName(@PluginName String pluginName) {
+    this.pluginName = pluginName;
+  }
+
+  public <K, V> MasterRemovalListener<K, V> get(String cacheName) {
+    return new MasterRemovalListener<K, V>(listenerFactories, pluginName,
+        cacheName);
+  }
+}
