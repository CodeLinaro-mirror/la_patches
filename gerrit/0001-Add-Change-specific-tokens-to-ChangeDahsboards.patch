 .../rpc/changedetail/ChangeDetailFactory.java      | 15 +++++++-
 .../gerrit/server/project/DashboardResource.java   | 34 ++++++++++++++++++
 .../server/project/DashboardsCollection.java       | 40 ++++++++++++++++++----
 .../google/gerrit/server/project/GetDashboard.java |  8 +++--
 .../gerrit/server/project/ListDashboards.java      |  1 +
 6 files changed, 100 insertions(+), 10 deletions(-)

diff --git a/Documentation/user-dashboards.txt b/Documentation/user-dashboards.txt
index 2910491..55dac78 100644
--- a/Documentation/user-dashboards.txt
+++ b/Documentation/user-dashboards.txt
@@ -171,6 +171,18 @@ the child projects.
   local-change = refs/meta/dashboards/main:local_change
 ----
 
+Change dashboard queries may contain the following additional tokens
+which will be replaced with change specific data:
+
+ ${branch}
+ ${change.id}
+ ${change.key}
+ ${project}
+ ${ref}
+ ${subject}
+ ${topic}
+
+
 GERRIT
 ------
 Part of link:index.html[Gerrit Code Review]
