+##
+##  $email          a reference to the class constructing the current email.
+##                  With this reference it is possible to call any public
+##                  method on the email class.
+##
+##  $messageClass   a String containing the messageClass
+##
+##  StringUtils     a reference to the apaache StringUtils class.  This can
+##                  be very usefull for formatting strings.
+##
+##
+## All change related emails have the following additional variables available
+## to them:
+##
+##  $change         a reference to the current change object
+##
+##  $branch         a reference to the bracn of this change
+##
+##  $projectName    the name of this change's project
+##
+##  $patchSet       a reference to the current patchSet
+##
+##  $patchSetInfo   a reference to the current patchSetInfo
+##
+## Of particular interest to this class is likely:
+##
+##  $email.reviewersNames  a list of the names of each reviewer.
+##
+#set ($destination = "Change $change.key.abbreviate() (patch set $patchSet.patchSetId) for $change.dest.shortName in $projectName:")
+#if($email.reviewersNames)
+Hello $StringUtils.join($email.reviewersNames, ' ,'),
+
+I'd like you to reexamine change ${change.key.abbreviate()}.#if($email.changeUrl)  Please visit
+
+    $email.changeUrl
+
+to look at patch set $patchSet.patchSetId
+#end
+
+$destination
+#else
+$destination
+#if($email.changeUrl)
+
+    $email.changeUrl
+
+#end
+#end
+
+$email.changeDetail
+  git pull ssh://$email.sshHost/$projectName $patchSet.refName
-- 
