+		qcom,mode = <1>;		/* Digital output */
+		qcom,invert = <0>;		/* Disable invert */
+		qcom,src-sel = <4>;		/* DTEST1 */
+		qcom,vin-sel = <0>;		/* VPH_PWR */
+		qcom,master-en = <1>;		/* Enable MPP */
+	};
+};
+
+&pm8916_gpios {
+	/* USB_HUB_RESET_N*/
+	gpio@c000 { /* GPIO 1 */
+		qcom,mode = <0>;	/* DIGITAL IN */
+		qcom,pull = <2>;	/* PULL UP */
+		qcom,vin-sel = <3>;	/* VPH */
+		qcom,src-sel = <0>;	/* CONSTANT */
+		qcom,master-en = <1>; 	/* ENABLE GPIO */
+		status = "okay";
+	};
+
+	/* USB_SW_SEL*/
+	gpio@c100 { /* GPIO 2 */
+		qcom,mode = <0>;	/* DIGITAL IN */
+		qcom,pull = <5>;	/* No PULL */
+		qcom,vin-sel = <0>;	/* VPH */
+		qcom,src-sel = <0>;	/* CONSTANT */
+		qcom,master-en = <1>; 	/* ENABLE GPIO */
+		status = "okay";
+	};
+
+	gpio@c200 { /* GPIO 3 */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,pull = <4>;		/* Pull down */
+		qcom,vin-sel = <2>;		/* VIN 2*/
+		qcom,src-sel = <1>;		/* GPIO */
+		qcom,master-en = <1>;	/* Enable GPIO */
+		status = "okay";
+	};
+
+	gpio@c300 { /* GPIO 4 */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,pull = <4>;		/* Pull down */
+		qcom,vin-sel = <2>;		/* VIN 2*/
+		qcom,src-sel = <1>;		/* GPIO */
+		qcom,master-en = <1>;	/* Enable GPIO */
+		status = "okay";
+	};
+};
+
+&spmi_bus {
+	qcom,pm8916@0 {
+		qcom,leds@c200  {
+			compatible = "qcom,leds-qpnp";
+			reg = <0xc200 0x100>;
+			status = "okay";
+			qcom,led_gpio_3 {
+				label = "gpio";
+				linux,name = "led3";
+				qcom,max-current = <40>;
+				qcom,id = <8>;
+				linux,default-trigger = "none";
+				qcom,default-state = "off";
+				qcom,source-sel = <1>;
+				qcom,mode-ctrl = <0x10>;
+				qcom,vin-ctrl = <0x02>;
+			};
+		};
+		qcom,leds@c300  {
+			compatible = "qcom,leds-qpnp";
+			reg = <0xc300 0x100>;
+			status = "okay";
+			qcom,led_gpio_4 {
+				label = "gpio";
+				linux,name = "boot";
+				qcom,max-current = <40>;
+				qcom,id = <8>;
+				linux,default-trigger =
+						"none";
+				qcom,default-state = "on";
+				qcom,source-sel = <1>;
+				qcom,mode-ctrl = <0x10>;
+				qcom,vin-ctrl = <0x02>;
+			};
+		};
+	};
+};
+
+/* RPM controlled regulators */
+&rpm_bus {
+	rpm-regulator-ldoa4 {
+		status = "disabled";
+		pm8916_l4 {
+			status = "disabled";
+		};
+	};
+
+	rpm-regulator-ldoa10 {
+		status = "disabled";
+		pm8916_l10 {
+			status = "disabled";
+		};
+	};
+
+	rpm-regulator-ldoa14 {
+		status = "disabled";
+		pm8916_l14 {
+			status = "disabled";
+		};
+	};
+
+	rpm-regulator-ldoa15 {
+		pm8916_l15 {
+			regulator-always-on;
+		};
+	};
+
+	rpm-regulator-ldoa16 {
+		pm8916_l16{
+			regulator-always-on;
+		};
+	};
+
+	rpm-regulator-ldoa17 {
+		pm8916_l17 {
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			qcom,init-voltage = <3300000>;
+		};
+	};
+
+	rpm-regulator-ldoa18 {
+		status = "disabled";
+		pm8916_l18 {
+			status = "disabled";
+		};
+	};
+
+	rpm-regulator-smpa3 {
+		pm8916_s3{
+			qcom,init-voltage = <1300000>;
+		};
+	};
+
+};
+
+&spmi_bus {
+	qcom,pm8916@0 {
+		qcom,leds@a100 { /* WLAN LED */
+		status = "okay";
+			qcom,led_mpp_2 {
+				label = "mpp";
+				linux,name = "wlan";
+				qcom,max-current = <40>;
+				qcom,id = <6>;
+				qcom,source-sel = <1>;
+				qcom,mode-ctrl = <0x60>;
+				qcom,mode = "manual";
+				linux,default-trigger =
+					"none";
+			};
+		};
+	};
+
+	qcom,pm8916@1 {
+		qcom,vibrator@c000 {
+			status = "okay";
+			qcom,vib-timeout-ms = <15000>;
+			qcom,vib-vtg-level-mV = <3100>;
+		};
+	};
+};
+
+
+
