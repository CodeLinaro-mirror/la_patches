+- APQ8016
+  compatible = "qcom,apq8016"
+
+- APQ8026
+  compatible = "qcom,apq8026"
+
+- APQ8074
+  compatible = "qcom,apq8074"
+
+- APQ8084
+  compatible = "qcom,apq8084"
+
