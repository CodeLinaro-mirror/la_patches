@@ -238,22 +352,22 @@ static int msm8994_liquid_dock_notify_handler(struct notifier_block *this,
 	u32 dock_plug_irq_flags = IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
 					IRQF_SHARED;
 	if (dock_event) {
