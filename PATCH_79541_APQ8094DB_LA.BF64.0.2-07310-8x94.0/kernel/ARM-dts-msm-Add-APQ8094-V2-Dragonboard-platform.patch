 arch/arm/boot/dts/qcom/apq8094-v2-dragonboard.dts | 23 +++++++++++++++++++++++
 2 files changed, 24 insertions(+)
 create mode 100644 arch/arm/boot/dts/qcom/apq8094-v2-dragonboard.dts

diff --git a/arch/arm/boot/dts/qcom/apq8094-v1-dragonboard.dts b/arch/arm/boot/dts/qcom/apq8094-v1-dragonboard.dts
