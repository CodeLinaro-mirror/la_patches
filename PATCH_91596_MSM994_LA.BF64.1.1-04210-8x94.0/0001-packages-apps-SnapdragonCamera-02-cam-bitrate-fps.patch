diff --git a/src/com/android/camera/VideoModule.java b/src/com/android/camera/VideoModule.java
index 6f35040..beb7350 100644
--- a/src/com/android/camera/VideoModule.java
+++ b/src/com/android/camera/VideoModule.java
@@ -196,6 +196,10 @@ public class VideoModule implements CameraModule,
     // The preview window is on focus
     private boolean mPreviewFocused = false;
 
+    //SDP preferences
+    int mVideoBitrate = 100000000;
+    int mVideoFramerate = 30;
+
     private final MediaSaveService.OnMediaSavedListener mOnVideoSavedListener =
             new MediaSaveService.OnMediaSavedListener() {
                 @Override
@@ -707,6 +711,20 @@ public class VideoModule implements CameraModule,
     public void onShutterButtonLongClick() {}
 
     private void qcomReadVideoPreferences() {
+        String videoBitrate = mPreferences.getString(
+                CameraSettings.KEY_VIDEO_BITRATE,
+                mActivity.getString(R.string.pref_camera_video_bitrate_default));
+        Log.v(TAG, "4kUHD Video Bitrate read from preferences = " +videoBitrate);
+        mVideoBitrate = Integer.parseInt(videoBitrate)*1000000;
+         Log.v(TAG, "4kUHD Video Bitrate selected = " +mVideoBitrate);
+
+         String videoFramerate = mPreferences.getString(
+                 CameraSettings.KEY_VIDEO_FPS,
+                 mActivity.getString(R.string.pref_camera_video_fps_default));
+         Log.v(TAG, "4kUHD Video Framerate read from preferences = " +videoFramerate);
+         mVideoFramerate = Integer.parseInt(videoFramerate);
+          Log.v(TAG, "4kUHD Video Framerate selected = " +mVideoFramerate);
+
         String videoEncoder = mPreferences.getString(
                CameraSettings.KEY_VIDEO_ENCODER,
                mActivity.getString(R.string.pref_camera_videoencoder_default));
@@ -1342,6 +1360,17 @@ public class VideoModule implements CameraModule,
         if (mCaptureTimeLapse) {
             double fps = 1000 / (double) mTimeBetweenTimeLapseFrameCaptureMs;
             setCaptureRate(mMediaRecorder, fps);
+            Log.v(TAG,"initializeRecorder Not setting custom bit and frame rates as TimeLapse is enabled ");
+        }else{
+            if (mProfile.quality == CamcorderProfile.QUALITY_2160P){
+                mMediaRecorder.setVideoEncodingBitRate(mVideoBitrate);
+                mMediaRecorder.setVideoFrameRate(mVideoFramerate);
+                Log.v(TAG,"initializeRecorder Custom UHD Framerate "+mVideoFramerate +" Bitrate "+mVideoBitrate);
+            }else{
+                mMediaRecorder.setVideoEncodingBitRate(mProfile.videoBitRate);
+                mMediaRecorder.setVideoFrameRate(mProfile.videoFrameRate);
+                Log.v(TAG,"initializeRecorder default Framerate "+mProfile.videoFrameRate +" Bitrate "+mProfile.videoBitRate);
+            }
         }
 
         setRecordLocation();
@@ -2259,9 +2288,17 @@ public class VideoModule implements CameraModule,
         mParameters.set("video-size", mProfile.videoFrameWidth+"x"+mProfile.videoFrameHeight);
         int[] fpsRange = CameraUtil.getMaxPreviewFpsRange(mParameters);
         if (fpsRange.length > 0) {
-            mParameters.setPreviewFpsRange(
-                    fpsRange[Parameters.PREVIEW_FPS_MIN_INDEX],
-                    fpsRange[Parameters.PREVIEW_FPS_MAX_INDEX]);
+            if (mProfile.quality == CamcorderProfile.QUALITY_2160P){
+                mParameters.setPreviewFpsRange(
+                        mVideoFramerate*1000,
+                        mVideoFramerate*1000);
+                Log.v(TAG,"UHD detected set preview FPS to custom FPS from "+(mVideoFramerate*1000) + " to "+ (mVideoFramerate*1000));
+            }else{
+                mParameters.setPreviewFpsRange(
+                        fpsRange[Parameters.PREVIEW_FPS_MIN_INDEX],
+                        fpsRange[Parameters.PREVIEW_FPS_MAX_INDEX]);
+                Log.v(TAG,"set preview FPS from "+fpsRange[Parameters.PREVIEW_FPS_MIN_INDEX] + " to "+ fpsRange[Parameters.PREVIEW_FPS_MAX_INDEX]);
+            }
         } else {
             mParameters.setPreviewFrameRate(mProfile.videoFrameRate);
         }
