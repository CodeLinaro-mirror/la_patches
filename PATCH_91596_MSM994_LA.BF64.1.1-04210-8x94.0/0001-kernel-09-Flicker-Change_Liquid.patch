Date: Thu, 5 Feb 2015 12:05:07 -0800
Subject: [PATCH] kernel-09-Flicker-Change

Change-Id: I33be6e8403d1b40171117681befbd1e0e28d597b
---
 drivers/video/msm/mdss/mdss_mdp.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/video/msm/mdss/mdss_mdp.c b/drivers/video/msm/mdss/mdss_mdp.c
index 2c61621..bf48cbd 100644
--- a/drivers/video/msm/mdss/mdss_mdp.c
+++ b/drivers/video/msm/mdss/mdss_mdp.c
@@ -382,7 +382,8 @@ static int mdss_mdp_bus_scale_set_quota(u64 ab_quota_rt, u64 ab_quota_nrt,
 		for (i = 0; i < total_axi_port_cnt; i++) {
 			vect = &bw_table->usecase[new_uc_idx].vectors[i];
 			vect->ab = ab_quota[i];
-			vect->ib = ib_quota[i];
+			//vect->ib = ib_quota[i];
+			vect->ib = 15000000000;
 
 			pr_debug("uc_idx=%d %s path idx=%d ab=%llu ib=%llu\n",
 				new_uc_idx, (i < rt_axi_port_cnt) ? "rt" : "nrt"
@@ -616,7 +617,8 @@ void mdss_mdp_set_clk_rate(unsigned long rate)
 	struct clk *clk = mdss_mdp_get_clk(MDSS_CLK_MDP_SRC);
 	unsigned long min_clk_rate;
 
-	min_clk_rate = max(rate, mdata->perf_tune.min_mdp_clk);
+	//min_clk_rate = max(rate, mdata->perf_tune.min_mdp_clk);
+	min_clk_rate = max(rate, (unsigned long)400000000);
 
 	if (clk) {
 		mutex_lock(&mdp_clk_lock);
-- 
