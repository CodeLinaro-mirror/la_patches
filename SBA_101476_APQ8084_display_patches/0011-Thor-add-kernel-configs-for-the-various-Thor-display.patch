+					29 01 00 00 00 00 06
+						9c 04 01 00 00 00	/* LVCFG */
+					29 01 00 00 00 00 06
+						20 05 1f 00 00 00	/* GPIOC */
+					29 01 00 00 00 00 06
+						24 05 08 00 00 00	/* GPIOO */];
+		qcom,mdss-dsi-off-command = [29 01 00 00 1e 00 06
+						04 05 ff 00 00 00	/* sw reset */];
+		qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
+		qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
