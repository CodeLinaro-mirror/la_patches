+#ifndef BOARD_8084_THOR_H
+#define BOARD_8084_THOR_H
+
+#define APQ8084_BLSP10_BLSP2_QUP4_QUP_BUS_ID   1
+#define THOR_I2C_LEFT_BUS_ID                   5
+#define THOR_I2C_RIGHT_BUS_ID                  6
+
+void __init thor_add_drivers(void);
+
+#endif /* BOARD_8084_THOR_H */
diff --git a/arch/arm/mach-msm/board-8084.c b/arch/arm/mach-msm/board-8084.c
index aa256ad..12bf4ca 100644
--- a/arch/arm/mach-msm/board-8084.c
+++ b/arch/arm/mach-msm/board-8084.c
@@ -38,6 +38,10 @@
 #include "clock.h"
 #include "platsmp.h"
 
+#ifdef CONFIG_CRD_THOR_DISPLAY
+#include "board-8084-thor.h"
+#endif
+
 static struct of_dev_auxdata apq8084_auxdata_lookup[] __initdata = {
 	OF_DEV_AUXDATA("qcom,msm-sdcc", 0xF9824000, "msm_sdcc.1", NULL),
 	OF_DEV_AUXDATA("qcom,sdhci-msm", 0xF9824900, "msm_sdcc.1", NULL),
@@ -107,6 +111,11 @@ void __init apq8084_init(void)
 
 	apq8084_init_gpiomux();
 	apq8084_add_drivers();
+#ifdef CONFIG_CRD_THOR_DISPLAY
+	if (of_board_is_sbc()) {
+		thor_add_drivers();
+	}
+#endif
 }
 
 void __init apq8084_init_very_early(void)
diff --git a/drivers/video/msm/mdss/mdss_dsi_panel.c b/drivers/video/msm/mdss/mdss_dsi_panel.c
index 5a1da57..51a4373 100644
--- a/drivers/video/msm/mdss/mdss_dsi_panel.c
+++ b/drivers/video/msm/mdss/mdss_dsi_panel.c
@@ -26,6 +26,10 @@
 
 #define DT_CMD_HDR 6
 
+#ifdef CONFIG_CRD_THOR_DISPLAY
+extern int mdss_dsi_platform_power(int intf, int on);
+#endif
+
 DEFINE_LED_TRIGGER(bl_led_trigger);
 
 void mdss_dsi_panel_pwm_cfg(struct mdss_dsi_ctrl_pdata *ctrl)
@@ -545,6 +549,10 @@ static int mdss_dsi_panel_on(struct mdss_panel_data *pdata)
 
 	pr_debug("%s: ctrl=%p ndx=%d\n", __func__, ctrl, ctrl->ndx);
 
+#ifdef CONFIG_CRD_THOR_DISPLAY
+	mdss_dsi_platform_power(ctrl->ndx, 1);
+#endif
+
 	if (pinfo->partial_update_dcs_cmd_by_left) {
 		if (ctrl->ndx != DSI_CTRL_LEFT)
 			goto end;
@@ -575,6 +583,10 @@ static int mdss_dsi_panel_off(struct mdss_panel_data *pdata)
 
 	pr_debug("%s: ctrl=%p ndx=%d\n", __func__, ctrl, ctrl->ndx);
 
+#ifdef CONFIG_CRD_THOR_DISPLAY
+       mdss_dsi_platform_power(ctrl->ndx, 0);
+#endif
+
 	if (pinfo->partial_update_dcs_cmd_by_left) {
 		if (ctrl->ndx != DSI_CTRL_LEFT)
 			goto end;
@@ -1111,6 +1123,16 @@ static int mdss_panel_parse_dt(struct device_node *np,
 		pinfo->mipi.dst_format =
 			DSI_VIDEO_DST_FORMAT_RGB888;
 	}
+#ifdef CONFIG_CRD_THOR_DISPLAY
+	/* the old driver used to allow specifying the format; this new
+	   driver derives the format from the bpp. In Thor's case, we
+	   need to specify a bpp of 24 but a format of RGB666 due to the
+	   bridge configuration. */
+	rc = of_property_read_u32(np, "qcom,mdss-dsi-dst-format", &tmp);
+	if (!rc) {
+		pinfo->mipi.dst_format = tmp;
+	}
+#endif
 	pdest = of_get_property(np,
 		"qcom,mdss-dsi-panel-destination", NULL);
 
