diff --git a/arch/arm/mach-msm/board-8084-thor.c b/arch/arm/mach-msm/board-8084-thor.c
new file mode 100644
index 0000000..3e1cdc8
--- /dev/null
+++ b/arch/arm/mach-msm/board-8084-thor.c
@@ -0,0 +1,161 @@
+/* Copyright (c) 2013-2014, The Linux Foundation. All rights reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 and
+ * only version 2 as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/kernel.h>
+#include <linux/platform_device.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <mach/board.h>
+#include "board-8084-thor.h"
+
+#ifdef CONFIG_CRD_THOR_DISPLAY
+#include <linux/i2c/pca954x.h>
+#include <linux/lumus_loe.h>
+#endif
+
+/*
+ * Platform data for display-related Thor devices
+ */
+#ifdef CONFIG_CRD_THOR_DISPLAY
+/* I2C mux */
+static struct pca954x_platform_mode pca954x_modes[] = {
+	{
+		.adap_id = THOR_I2C_LEFT_BUS_ID,
+		.deselect_on_exit = 0
+	},
+	{
+		.adap_id = THOR_I2C_RIGHT_BUS_ID,
+		.deselect_on_exit = 0
+	},
+};
+
+static struct pca954x_platform_data pca954x_data = {
+	.modes = pca954x_modes,
+	.num_modes = ARRAY_SIZE(pca954x_modes)
+};
+
+#ifdef CONFIG_CRD_THOR_DISPLAY_SVGA
+	#ifdef CONFIG_CRD_THOR_DISPLAY_SVGA_100
+		#define THOR_DISPLAY_RES	LUMUS_LOE_RES_800x600_SCALED_TO_1280x720_100FPS
+	#else
+		#define THOR_DISPLAY_RES	LUMUS_LOE_RES_800x600_SCALED_TO_1280x720_120FPS
+	#endif
+#else
+	#ifdef CONFIG_CRD_THOR_DISPLAY_100
+		#define THOR_DISPLAY_RES	LUMUS_LOE_RES_1280x720_100FPS
+	#else
+		#define THOR_DISPLAY_RES	LUMUS_LOE_RES_1280x720_60FPS
+	#endif
+#endif
+
+/* Lumus LOEs */
+struct lumus_loe_platform_data lumus_loe_left_platform_data = {
+	.resolution = THOR_DISPLAY_RES,
+};
+struct lumus_loe_platform_data lumus_loe_right_platform_data = {
+	.resolution = THOR_DISPLAY_RES,
+};;
+#endif
+
+/*
+ * I2C board info structures
+ */
+#ifdef CONFIG_CRD_THOR_DISPLAY
+static struct i2c_board_info pca954x_i2c_info[] __initdata = {
+	{
+		I2C_BOARD_INFO("pca9540", 0x70),
+		.platform_data = &pca954x_data
+	},
+};
+
+static struct i2c_board_info lumus_loe_left_i2c_info[] __initdata = {
+	{
+		I2C_BOARD_INFO("lumus_loe_left", 0x52),
+		.platform_data = &lumus_loe_left_platform_data
+	},
+};
+
+static struct i2c_board_info lumus_loe_right_i2c_info[] __initdata = {
+	{
+		I2C_BOARD_INFO("lumus_loe_right", 0x52),
+		.platform_data = &lumus_loe_right_platform_data
+	},
+};
+#endif
+
+struct i2c_registry {
+	int                    bus;
+	struct i2c_board_info *info;
+	int                    len;
+};
+
+static struct i2c_registry thor_i2c_devices[] __initdata = {
+#ifdef CONFIG_CRD_THOR_DISPLAY
+	{
+		APQ8084_BLSP10_BLSP2_QUP4_QUP_BUS_ID,
+		pca954x_i2c_info,
+		ARRAY_SIZE(pca954x_i2c_info),
+	},
+	{
+		THOR_I2C_LEFT_BUS_ID,
+		lumus_loe_left_i2c_info,
+		ARRAY_SIZE(lumus_loe_left_i2c_info),
+	},
+	{
+		THOR_I2C_RIGHT_BUS_ID,
+		lumus_loe_right_i2c_info,
+		ARRAY_SIZE(lumus_loe_right_i2c_info),
+	},
+#endif
+};
+
+static void __init thor_register_i2c_devices(void)
+{
+	int i;
+
+	/* Run the array and install devices as appropriate */
+	for (i = 0; i < ARRAY_SIZE(thor_i2c_devices); ++i) {
+		i2c_register_board_info(thor_i2c_devices[i].bus,
+					thor_i2c_devices[i].info,
+					thor_i2c_devices[i].len);
+	}
+}
+
+void __init thor_add_drivers(void)
+{
+	thor_register_i2c_devices();
+}
+
+#ifdef CONFIG_CRD_THOR_DISPLAY
+/* intf: 0 = left, 1 = right */
+int mdss_dsi_platform_power(int intf, int on)
+{
+	struct lumus_loe_platform_data *pdata;
+	if (intf == 0) {
+		pdata = &lumus_loe_left_platform_data;
+	} else {
+		pdata = &lumus_loe_right_platform_data;
+	}
+	if (on) {
+		if (pdata->ctxt != NULL && pdata->power_on != NULL) {
+			return pdata->power_on(pdata->ctxt);
+		}
+	} else {
+		if (pdata->ctxt != NULL && pdata->power_off != NULL) {
+			return pdata->power_off(pdata->ctxt);
+		}
+	}
+	return 0;
+}
+#endif
