-	model = "QTI APQ 8084 v1.1 SBC (Thor Dual 720p 100fps)";
+	model = "QTI APQ 8084 v1.1 SBC (Thor Dual 720p 100 fps)";
 	compatible = "qcom,apq8084-sbc", "qcom,apq8084", "qcom,sbc";
 	qcom,board-id = <24 0>;
 };
