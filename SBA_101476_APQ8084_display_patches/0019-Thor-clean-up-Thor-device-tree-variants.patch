 #include "apq8084-sbc.dtsi"
 #include "apq8084-camera-sensor-sbc.dtsi"
-#include "apq8084-display-sbc-thor-svga-100.dtsi"
+#include "apq8084-display-sbc-thor-svga.dtsi"
+
+&dsi_dual_hx7816a_svga_video_0 {
+	qcom,mdss-dsi-panel-framerate = <100>;
+	qcom,mdss-dsi-v-pulse-width = <123>;
