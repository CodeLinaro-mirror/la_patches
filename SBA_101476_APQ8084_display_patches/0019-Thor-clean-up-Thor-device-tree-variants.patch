Subject: [PATCH] Thor: clean up Thor device tree variants

Change-Id: I32776ba65fe2547acfb6836fba502b72a515924f
---
 arch/arm/boot/dts/qcom/Makefile                    | 29 +++++++++++-----------
 .../qcom/apq8084-display-sbc-thor-720p-100.dtsi    | 29 ----------------------
 .../qcom/apq8084-display-sbc-thor-svga-100.dtsi    | 29 ----------------------
 .../qcom/apq8084-v1.1-sbc-thor-dual-720p-100.dts   | 14 +++++++++--
 .../dts/qcom/apq8084-v1.1-sbc-thor-dual-720p.dts   |  6 +----
 .../qcom/apq8084-v1.1-sbc-thor-dual-svga-100.dts   | 16 ++++++++++--
 .../dts/qcom/apq8084-v1.1-sbc-thor-dual-svga.dts   |  2 +-
 7 files changed, 43 insertions(+), 82 deletions(-)
 delete mode 100644 arch/arm/boot/dts/qcom/apq8084-display-sbc-thor-720p-100.dtsi
 delete mode 100644 arch/arm/boot/dts/qcom/apq8084-display-sbc-thor-svga-100.dtsi

diff --git a/arch/arm/boot/dts/qcom/Makefile b/arch/arm/boot/dts/qcom/Makefile
index 168c3d0..f0ca552 100644
--- a/arch/arm/boot/dts/qcom/Makefile
+++ b/arch/arm/boot/dts/qcom/Makefile
@@ -125,21 +125,22 @@ dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.0-old-pwr-grid-liquid.dtb \
 	apq8084-v1.1-odgx7.dtb
 
 ifdef CONFIG_CRD_THOR_DISPLAY
-ifdef CONFIG_CRD_THOR_DISPLAY_SVGA
-ifdef CONFIG_CRD_THOR_DISPLAY_SVGA_100
-dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc-thor-dual-svga-100.dtb
+	ifdef CONFIG_CRD_THOR_DISPLAY_SVGA
+		ifdef CONFIG_CRD_THOR_DISPLAY_SVGA_100
+			THOR_DISPLAY_POSTFIX := dual-svga-100
+		else
+			THOR_DISPLAY_POSTFIX := dual-svga
+		endif
+	else
+		ifdef CONFIG_CRD_THOR_DISPLAY_100
+			THOR_DISPLAY_POSTFIX := dual-720p-100
+		else
+			THOR_DISPLAY_POSTFIX := dual-720p
+		endif
+	endif
+	dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc-thor-$(THOR_DISPLAY_POSTFIX).dtb
 else
-dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc-thor-dual-svga.dtb
-endif
-else
-ifdef CONFIG_CRD_THOR_DISPLAY_100
-dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc-thor-dual-720p-100.dtb
-else
-dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc-thor-dual-720p.dtb
-endif
-endif
-else
-dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc.dtb
+	dtb-$(CONFIG_ARCH_APQ8084) += apq8084-v1.1-sbc.dtb
 endif
 
 dtb-$(CONFIG_ARCH_MSM) += msmplutonium-sim.dtb
