--- a/arch/arm/boot/dts/qcom/apq8084-v1.1-sbc-thor-dual-720p-100.dts
+++ b/arch/arm/boot/dts/qcom/apq8084-v1.1-sbc-thor-dual-720p-100.dts
@@ -15,10 +15,20 @@
 #include "apq8084-v1.1.dtsi"
 #include "apq8084-sbc.dtsi"
 #include "apq8084-camera-sensor-sbc.dtsi"
-#include "apq8084-display-sbc-thor-720p-100.dtsi"
+#include "apq8084-display-sbc-thor-720p.dtsi"
+
+&dsi_dual_hx7816a_720p_video_0 {
+	qcom,mdss-dsi-panel-framerate = <100>;
+	qcom,mdss-dsi-panel-timings = [a9 24 18 00 4e 52 1c 28 1f 03 04 00];
+};
+
+&dsi_dual_hx7816a_720p_video_1 {
+	qcom,mdss-dsi-panel-framerate = <100>;
+	qcom,mdss-dsi-panel-timings = [a9 24 18 00 4e 52 1c 28 1f 03 04 00];
+};
 
