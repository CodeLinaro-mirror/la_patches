+/*
+ * Lumus LOE driver.
+ */
+
+/* #define DEBUG 1 */
+
+#define DRV_NAME "lumus_loe"
+
+#include <linux/slab.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/lumus_loe.h>
+#include <linux/module.h>
+
+// for 1280x720
+#define DEFAULT_BORDER_WIDTH       48
+#define DEFAULT_BORDER_HEIGHT      28
+
+#define UNLOCK_CODE			0x5143
+
+#define I2C_ADDR_HX7816		0x3C
+#define I2C_ADDR_HX7318		0x49
+
+#define HX7318_CTRL_REG_MASK   0x21
+
+#define BACKLIGHT_DEFAULT 	7000
+
+#define I2C_WRITE_REG(i2c,reg,val)														\
+	if (i2c_smbus_write_byte_data(i2c,reg,val)) { 										\
+		pr_debug("%s: i2c_smbus_write_byte_data failed for reg %x",__func__, reg);		\
+		break;																			\
+	} else {																			\
+		usleep(10000);																	\
+	}																					\
+
+typedef enum
+{
+  GET_DEVICE_INFO,        // 0
+  SET_DEVICE_INFO,
+  GET_SW_REVISION,
+  SET_NRST_LCD,
+  SET_BACKLIGHT,
+  GET_BACKLIGHTLIMITS,
+  SET_BACKLIGHTLIMITS,
+  GET_LCD_CONTROL,
+  SET_LCD_CONTROL,
+  GET_GAMMA,
+  SET_GAMMA,             // 10
+  GET_SCREENPOS,
+  SET_SCREENPOS,
+  GET_SERLOCK,
+  SET_BISTEN,
+  GET_CONTRAST,
+  SET_CONTRAST,
+  GET_BRIGHTNESS,
+  SET_BRIGHTNESS,
+  GET_HUE,
+  SET_HUE,
+  GET_SAT,
+  SET_SAT                // 22
+} head_362_cmd_T;
+
+typedef struct
+{
+  short Vendor_ID;
+  short Device_ID;
+  short BoardRevision;
+  char  ManufactureWeek;
+  char  ManufactureYear;
+  short SerNum;
+  char  Flags;  // left=0 right=1
+}HW_Info_T;
+
+typedef struct
+  {
+      unsigned short Red;
+      unsigned short Green;
+      unsigned short Blue;
+} H_381_BL_T;
+
+struct lumus_loe {
+	struct i2c_device_id *id;
+
+	/* the three I2C devices in the LOE */
+	struct i2c_client *ctrl;	// MSP430
+	struct i2c_client *asic;	// HX7816
+	struct i2c_client *lcos;	// HX7318
+
+	/* device provisioning */
+	int allow_write;
+	HW_Info_T HW;
+	short screen_pos;
+
+	/* scrolling border offsets */
+	int x_offset;
+	int y_offset;
+
+	int resolution;
+};
+
+static void lumus_loe_update_border(struct lumus_loe *me);
+static int lumus_loe_update_deviceinfo(struct lumus_loe *me, HW_Info_T *pHW);
+
+/******************************************************************************
+ * sysfs attributes
+ *
+ *   Device provisioning:
+ *       'unlock'     :  Write Only. To prevent accidentally overwriting non-
+ *                       volatile provisioned data, this node must be written
+ *                       with UNLOCK_CODE before setting the provisioned data.
+ *                       It is a one-shot, so the unlock code must be written
+ *                       prior to writing each provisioned data nodes.
+ *       'serial_num' :  Read/Write. Allows reading/writing the 16-bit serial
+ *                       number field of the LOE's Device Info provisioned data.
+ *                       Requires unlocking to write.
+ *       'screen_pos' :  Read/Write. Allows reading/writing the 16-bit Screen
+ *                       Position provisioned data. Requires unlocking to write.
+ *                       Bits 15-8 set the initial x_offset and bits 7-0 set the
+ *                       initial y_offset. Changing this value won't affect the
+ *                       actual screen position until the next boot.
+ *
+ *   Scrolling border:
+ *       'x_offset'   :  Read/Write. The default value of this node comes from
+ *                       the provisioned Screen Position value (see
+ *                       'screen_pos'). Writing the x_offset value will change
+ *                       the horizontal border width at run-time. The range
+ *                       depends on the width of the active area of the display.
+ *                       For example, if the active area width is 1280, the
+ *                       range of this node will be 1376 - 1280 = 96 so the
+ *                       range would be -48 to 48.
+ *       'y_offset'   :  Read/Write. The default value of this node comes from
+ *                       the provisioned Screen Position value (see
+ *                       'screen_pos'). Writing the y_offset value will change
+ *                       the vertical border height at run-time. The range
+ *                       depends on the height of the active area of the
+ *                       display. For example, if the active area height is 720,
+ *                       the range of this node will be 776 - 720 = 56 so the
+ *                       range would be -28 to 28.
+ *****************************************************************************/
+
+/* 'unlock' write */
+static ssize_t lumus_loe_set_unlock(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	unsigned long code;
+
+	if (strict_strtoul(buf, 16, &code) == 0 && code == UNLOCK_CODE) {
+		me->allow_write = 1;
+	}
+	return strlen(buf);
+}
+
+static DEVICE_ATTR(unlock, S_IWUGO, NULL, lumus_loe_set_unlock);
+
+/* 'serial_num' read */
+static ssize_t lumus_loe_show_serial_num(struct device *dev,
+				 struct device_attribute *attr,
+				 char *buf)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	return sprintf(buf, "0x%04x\n", (short) me->HW.SerNum);
+}
+
+/* 'serial_num' write */
+static ssize_t lumus_loe_set_serial_num(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	unsigned long serial_num;
+	int rc;
+
+	rc = strict_strtoul(buf, 16, &serial_num);
+	if (rc || serial_num > 0xffff) {
+		pr_err("%s: invalid serial number: %s", __func__, buf);
+	} else {
+		HW_Info_T HW;
+		memcpy(&HW, &me->HW, sizeof(HW));
+		HW.SerNum = (short) serial_num;
+		rc = lumus_loe_update_deviceinfo(me, &HW);
+		if (rc != 0) {
+			pr_err("%s: failed to write serial number: %d", __func__, rc);
+		}
+	}
+	return strlen(buf);
+}
+
+static DEVICE_ATTR(serial_num, S_IRUGO | S_IWUGO, lumus_loe_show_serial_num, lumus_loe_set_serial_num);
+
+/* 'screen_pos' read */
+static ssize_t lumus_loe_show_screen_pos(struct device *dev,
+				 struct device_attribute *attr,
+				 char *buf)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	return sprintf(buf, "0x%04x\n", me->screen_pos & 0xffff);
+}
+
+/* 'screen_pos' write */
+static ssize_t lumus_loe_set_screen_pos(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+
+	if (me->allow_write) {
+		unsigned long sp;
+		int rc;
+		signed char pos[2];
+
+		rc = strict_strtoul(buf, 16, &sp);
+
+		pos[0] = (sp >> 8) & 0xff;	// x_offset
+		pos[1] = sp & 0xff;       	// y_offset
+
+		if (rc || sp > 0xffff ||
+		    abs(pos[0]) > DEFAULT_BORDER_WIDTH || abs(pos[1]) > DEFAULT_BORDER_HEIGHT) {
+			pr_err("%s: invalid screen position: %s", __func__, buf);
+		} else {
+			rc = i2c_smbus_write_i2c_block_data(me->ctrl, SET_SCREENPOS, sizeof(pos),(void*) pos);
+			if (rc == 0) {
+				me->screen_pos = (short) sp;
+			} else {
+				pr_err("%s: failed to write screen position: %d", __func__, rc);
+			}
+		}
+		me->allow_write = 0;
+	}
+	return strlen(buf);
+}
+
+static DEVICE_ATTR(screen_pos, S_IRUGO | S_IWUGO, lumus_loe_show_screen_pos, lumus_loe_set_screen_pos);
+
+/* 'x_offset' read */
+static ssize_t lumus_loe_show_x_offset(struct device *dev,
+				 struct device_attribute *attr,
+				 char *buf)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	return sprintf(buf, "%d\n", me->x_offset);
+}
+
+/* 'x_offset' write */
+static ssize_t lumus_loe_set_x_offset(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	long x = 0;
+	int rc;
+
+	rc = strict_strtol(buf, 10, &x);
+	if (rc || abs(x) > DEFAULT_BORDER_WIDTH) {
+		pr_err("%s: invalid x offset, range is -%d to %d", __func__,
+			DEFAULT_BORDER_WIDTH, DEFAULT_BORDER_WIDTH);
+	} else {
+		me->x_offset = x;
+		lumus_loe_update_border(me);
+	}
+	return strlen(buf);
+}
+
+static DEVICE_ATTR(x_offset, S_IRUGO | S_IWUGO, lumus_loe_show_x_offset, lumus_loe_set_x_offset);
+
+/* 'y_offset' read */
+static ssize_t lumus_loe_show_y_offset(struct device *dev,
+				 struct device_attribute *attr,
+				 char *buf)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	return sprintf(buf, "%d\n", me->y_offset);
+}
+
+/* 'y_offset' write */
+static ssize_t lumus_loe_set_y_offset(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct lumus_loe *me = (struct lumus_loe*) i2c_get_clientdata(client);
+	long y;
+	int rc;
+
+	rc = strict_strtol(buf, 10, &y);
+	if (rc || abs(y) > DEFAULT_BORDER_HEIGHT) {
+		pr_err("%s: invalid y offset, range is -%d to %d", __func__,
+			DEFAULT_BORDER_HEIGHT, DEFAULT_BORDER_HEIGHT);
+	} else {
+		me->y_offset = y;
+		lumus_loe_update_border(me);
+	}
+	return strlen(buf);
+}
+
+static DEVICE_ATTR(y_offset, S_IRUGO | S_IWUGO, lumus_loe_show_y_offset, lumus_loe_set_y_offset);
+
+static struct attribute *lumus_loe_attrs[] = {
+	&dev_attr_unlock.attr,
+	&dev_attr_serial_num.attr,
+	&dev_attr_screen_pos.attr,
+	&dev_attr_x_offset.attr,
+	&dev_attr_y_offset.attr,
+	NULL,
+};
+
+static struct attribute_group lumus_loe_attr_group = {
+	.attrs = lumus_loe_attrs,
+};
+/******************************************************************************
+ *****************************************************************************/
+
+static void lumus_loe_update_border(struct lumus_loe *me)
+{
+	int l, r, u, d;
+	l = DEFAULT_BORDER_WIDTH + me->x_offset;
+	r = (DEFAULT_BORDER_WIDTH*2) - l;
+	u = DEFAULT_BORDER_HEIGHT + me->y_offset;
+	d = (DEFAULT_BORDER_HEIGHT*2) - u;
+	i2c_smbus_write_byte_data(me->asic, 0x7B, 0x0F);   // BORDER L/R addr
+	i2c_smbus_write_byte_data(me->asic, 0x7C, l);      // BORDER left
+	i2c_smbus_write_byte_data(me->asic, 0x7D, r);      // BORDER right
+	i2c_smbus_write_byte_data(me->asic, 0x7C, u);      // BORDER up
+	i2c_smbus_write_byte_data(me->asic, 0x7D, d);      // BORDER down
+	pr_debug("%s: left=%d, right=%d, up=%d, down=%d", __func__, l, r, u, d);
+}
+
+static int lumus_loe_update_deviceinfo(struct lumus_loe *me, HW_Info_T *pHW)
+{
+	int rc = -1;
+	if (me->allow_write) {
+		/* the first two shorts must be skipped to write the device info */
+		rc = i2c_smbus_write_i2c_block_data(me->ctrl, SET_DEVICE_INFO,
+			sizeof(*pHW)-4, (unsigned char*)(((int)pHW)+4));
+		if (rc == 0) {
+			/* update our cached copy */
+			memcpy(&me->HW, pHW, sizeof(*pHW));
+		}
+		me->allow_write = 0;
+	}
+	return rc;
+}
+
+static int lumus_loe_init_HX7816(struct lumus_loe *me)
+{
+	int ret = -1;
+
+	pr_debug("%s: initializing HX7816 LCOS controller", __func__);
+
+	switch (me->resolution) {
+	case LUMUS_LOE_RES_1280x720_60FPS:
+	case LUMUS_LOE_RES_1280x720_100FPS:
+		I2C_WRITE_REG(me->asic, 0xFE, 0x33);   // Password
+
+		// INP Format
+		I2C_WRITE_REG(me->asic, 0x10, 0x07);   // INP_CTRL: SYNC+DE mode, HS,VS negative polarity
+		I2C_WRITE_REG(me->asic, 0x11, 0x69);   // INP_HSTART = 0x69 = 105
+		I2C_WRITE_REG(me->asic, 0x12, 0x00);   //
+		I2C_WRITE_REG(me->asic, 0x13, 0xae);   // INP_HTOTAL = 0x5ae = 1454
+		I2C_WRITE_REG(me->asic, 0x14, 0x05);
+		I2C_WRITE_REG(me->asic, 0x15, 0x00);   // INP_HSIZE  = 0x500 = 1280
+		I2C_WRITE_REG(me->asic, 0x16, 0x05);
+		I2C_WRITE_REG(me->asic, 0x17, 0x1a);   // INP_VSTART = 26
+		I2C_WRITE_REG(me->asic, 0x18, 0x00);
+		I2C_WRITE_REG(me->asic, 0x19, 0xeb);   // INP_VTOTAL = 747
+		I2C_WRITE_REG(me->asic, 0x1a, 0x02);
+		I2C_WRITE_REG(me->asic, 0x1B, 0xd0);   // INP_VSIZE = 0x2d0 = 720
+		I2C_WRITE_REG(me->asic, 0x1C, 0x02);
+
+		// Embedded Pattern Generator
+		I2C_WRITE_REG(me->asic, 0x30, 0x51);   // TP Pattern 1280x720
+		I2C_WRITE_REG(me->asic, 0x3A, 0x3d);   // VS RESET
+		I2C_WRITE_REG(me->asic, 0x3B, 0x61);
+		I2C_WRITE_REG(me->asic, 0x3C, 0x00);
+
+		// Scalar and Embedded Pattern Output Timing
+		I2C_WRITE_REG(me->asic, 0x40, 0x80);   // scaler out H_total = 1664
+		I2C_WRITE_REG(me->asic, 0x41, 0x06);
+		I2C_WRITE_REG(me->asic, 0x42, 0x10);   // H_SYNC = 16
+		I2C_WRITE_REG(me->asic, 0x43, 0x00);
+		I2C_WRITE_REG(me->asic, 0x44, 0x54);   // H_Start = 84 (H_Start=256 KSC ok but 257 fail)
+		I2C_WRITE_REG(me->asic, 0x45, 0x00);
+		I2C_WRITE_REG(me->asic, 0x46, 0x00);   // H_Size = 1280
+		I2C_WRITE_REG(me->asic, 0x47, 0x05);
+		I2C_WRITE_REG(me->asic, 0x48, 0x34);   // V_TOTAL = 820
+		I2C_WRITE_REG(me->asic, 0x49, 0x03);
+		I2C_WRITE_REG(me->asic, 0x4A, 0x03);   // V_Sync = 3
+		I2C_WRITE_REG(me->asic, 0x4B, 0x00);
+		I2C_WRITE_REG(me->asic, 0x4C, 0x1C);   // V_Start = 28
+		I2C_WRITE_REG(me->asic, 0x4D, 0x00);
+		I2C_WRITE_REG(me->asic, 0x4E, 0xd0);   // V_Size = 720
+		I2C_WRITE_REG(me->asic, 0x4F, 0x02);
+
+		// Keystone Correction
+		I2C_WRITE_REG(me->asic, 0x54, 0x03);   // KSC disable, WXGA resolution ?????????
+
+		// Scalar Setting
+		I2C_WRITE_REG(me->asic, 0x66, 0x00);   // Y_ratio
+		I2C_WRITE_REG(me->asic, 0x67, 0x00);
+		I2C_WRITE_REG(me->asic, 0x68, 0x00);
+		I2C_WRITE_REG(me->asic, 0x69, 0x00);   // Y= (768-1)/(768-1)*4096= 4096
+		I2C_WRITE_REG(me->asic, 0x6A, 0x00);
+		I2C_WRITE_REG(me->asic, 0x66, 0x01);   // X_ratio
+		I2C_WRITE_REG(me->asic, 0x67, 0x00);
+		I2C_WRITE_REG(me->asic, 0x68, 0x00);
+		I2C_WRITE_REG(me->asic, 0x69, 0x00);   // X= (1366-1)/(1366-1)*4096= 4096
+		I2C_WRITE_REG(me->asic, 0x6A, 0x00);
+		I2C_WRITE_REG(me->asic, 0x6B, 0x30);   // SCALER Disable, x delay =3
+
+		// SDRAM Control
+		I2C_WRITE_REG(me->asic, 0x70, 0x01);   // NORMAL, 2 SDRAM
+		I2C_WRITE_REG(me->asic, 0x73, 0x03);   // SAMPLE PHASE , latency =3
+
+		// Frame Control
+		I2C_WRITE_REG(me->asic, 0x77, 0x08);   // Sub-Frame 8
+		I2C_WRITE_REG(me->asic, 0x78, 0x50);   // RRGGBBGG
+		I2C_WRITE_REG(me->asic, 0x79, 0x5A);
+		I2C_WRITE_REG(me->asic, 0x7A, 0x0F);
+		I2C_WRITE_REG(me->asic, 0x7B, 0x00);   // V_Total_Address
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_0
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_0
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_1
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_1
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_2
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_2
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_3
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_3
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_4
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_4
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_5
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_5
+		I2C_WRITE_REG(me->asic, 0x7C, 0x50);   // V_Total_6
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_6
+		I2C_WRITE_REG(me->asic, 0x7C, 0x40);   // V_Total_7
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);   // V_Total_7
+		I2C_WRITE_REG(me->asic, 0x7B, 0x0A);   // H_Total_Address
+		I2C_WRITE_REG(me->asic, 0x7C, 0x70);   // H_Total     // 1648 (under 1641 results in green line)
+		I2C_WRITE_REG(me->asic, 0x7D, 0x06);
+		I2C_WRITE_REG(me->asic, 0x7C, 0x54);   // H_ACT_STR   // 84
+		I2C_WRITE_REG(me->asic, 0x7D, 0x00);
+		I2C_WRITE_REG(me->asic, 0x7C, 0x60);   // H_ACT_SIZE  // 1376
+		I2C_WRITE_REG(me->asic, 0x7D, 0x05);
+		I2C_WRITE_REG(me->asic, 0x7C, 0x0a);   // V_ACT_STR   // 10
+		I2C_WRITE_REG(me->asic, 0x7D, 0x00);
+		I2C_WRITE_REG(me->asic, 0x7C, 0x08);   // V_ACT_SIZE  // 776
+		I2C_WRITE_REG(me->asic, 0x7D, 0x03);
+		lumus_loe_update_border(me);
+		I2C_WRITE_REG(me->asic, 0x7E, 0x10);   // BORDER Enable
+
+		// MINI-DSI Controller
