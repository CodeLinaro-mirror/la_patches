+		I2C_WRITE_REG(me->lcos, 0x4F, 0x3C);
+		I2C_WRITE_REG(me->lcos, 0x50, 0x20);
+
+		ret = 0;
+
+	} while (0);
+
+	pr_debug("%s: %s", __func__, (0 == ret) ? "success" : "failed");
+
+	return ret;
+}
+
+static int lumus_loe_init_eye(struct lumus_loe *me)
+{
+	int ret = -1;
+
+	do {
+		char ctrl = 0;
+		signed char pos[2];
+		H_381_BL_T Backlight = { BACKLIGHT_DEFAULT, BACKLIGHT_DEFAULT, BACKLIGHT_DEFAULT };
+		int retries = 0;
+
+		/* try to read device info */
+		while (retries < 10) {
+			if (i2c_smbus_read_i2c_block_data(me->ctrl, GET_DEVICE_INFO, sizeof(me->HW), (unsigned char*)&me->HW)==sizeof(me->HW)) {
+				pr_info("\tVendor ID = %04x", me->HW.Vendor_ID);
+				pr_info("\tDevice ID = %04x", me->HW.Device_ID);
+				pr_info("\tBoard Revision = %04x", me->HW.BoardRevision);
+				pr_info("\tManufacture Week = %d", me->HW.ManufactureWeek);
+				pr_info("\tManufacture Year = %d", me->HW.ManufactureYear);
+				pr_info("\tSerial Number = %04x", me->HW.SerNum);
+				pr_info("\tFlags = %d", me->HW.Flags);
+				break;
+			} else {
+				pr_err("%s: error reading device info", __func__);
+			}
+			usleep(10000);
+			retries++;
+		}
+
+		if (retries == 10) {
+			pr_err("%s: failed to get device info after %d tries", __func__, 10);
+			break;
+		}
+
+		ctrl = i2c_smbus_read_byte_data(me->ctrl, GET_LCD_CONTROL);
+		ctrl |= HX7318_CTRL_REG_MASK;
+
+		(void) i2c_smbus_write_byte_data(me->ctrl, SET_NRST_LCD, 0);
+		usleep(10000);
+		(void) i2c_smbus_write_byte_data(me->ctrl, SET_NRST_LCD, 1);
+		usleep(100000);
+
+		/* get screen position offsets */
+		if (i2c_smbus_read_i2c_block_data(me->ctrl, GET_SCREENPOS, sizeof(pos),(void*) pos) == sizeof(pos)) {
+			me->x_offset = pos[0];
+			me->y_offset = pos[1];
+			me->screen_pos = (me->x_offset << 8) + me->y_offset;
+			pr_debug("%s: offsets are x=%d, y=%d", __func__, me->x_offset, me->y_offset);
+		} else {
+			pr_err("%s: error reading screen positions", __func__);
+			ret = -1;
+			break;
+		}
+
+		/* initialize ASIC */
+		ret = lumus_loe_init_HX7816(me);
+		if (ret < 0) {
+			pr_err("%s: error initializing Himax ASIC", __func__);
+			break;
+		}
+
+		/* initialize LCOS */
+		ret = lumus_loe_init_HX7318(me, ctrl);
+		if (ret < 0) {
+			pr_err("%s: error initializing Himax LCOS", __func__);
+			break;
+		}
+
+		/* set backlight */
+		(void) i2c_smbus_write_i2c_block_data(me->ctrl, SET_BACKLIGHT, sizeof(Backlight), (unsigned char*)&Backlight);	///* set backlight value */
+
+		ret = 0;
+
+	} while (0);
+
+	return ret;
+}
+
+int lumus_loe_power_on(void *ctxt)
+{
+	struct lumus_loe* me = (struct lumus_loe*) ctxt;
+	if (me == NULL) {
+		return 1;
+	}
+	pr_info("%s:%s", __func__, me->id->name);
+	return lumus_loe_init_eye(me);
+}
+
+int lumus_loe_power_off(void *ctxt)
+{
+	struct lumus_loe* me = (struct lumus_loe*) ctxt;
+	if (me == NULL) {
+		return 1;
+	}
+	pr_info("%s:%s", __func__, me->id->name);
+
+	/* reset the controller to turn off the display */
+	(void) i2c_smbus_write_byte_data(me->ctrl, SET_NRST_LCD, 0);
+	usleep(10000);
+	(void) i2c_smbus_write_byte_data(me->ctrl, SET_NRST_LCD, 1);
+	usleep(100000);
+
+	return 0;
+}
+
+/*
+ * I2C init/probing/exit functions
+ */
+static int lumus_loe_probe(struct i2c_client *client,
+			 const struct i2c_device_id *id)
+{
+	struct i2c_adapter *adap = to_i2c_adapter(client->dev.parent);
+	struct lumus_loe_platform_data *pdata = client->dev.platform_data;
+	struct lumus_loe *data;
+	int ret = -ENODEV;
+
+	if (!i2c_check_functionality(adap, I2C_FUNC_SMBUS_WORD_DATA))
+		goto err;
+
+	if (pdata == NULL) {
+		pr_err("%s: platform data is NULL", __func__);
+		goto err;
+	}
+
+	data = kzalloc(sizeof(struct lumus_loe), GFP_KERNEL);
+	if (!data) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	data->id = (struct i2c_device_id*) id;
+	data->ctrl = client;	// address 0x52
+	data->resolution = pdata->resolution;
+
+	data->asic = i2c_new_dummy(client->adapter, I2C_ADDR_HX7816);
+	if (data->asic == NULL) {
+		pr_err("%s: failed to create i2c client for LCOS controller", __func__);
+		goto exit_free;
+	}
+
+	data->lcos = i2c_new_dummy(client->adapter, I2C_ADDR_HX7318);
+	if (data->lcos == NULL) {
+		pr_err("%s: failed to create i2c client for LCOS", __func__);
+		goto exit_free;
+	}
+
+	if (sysfs_create_group(&client->dev.kobj, &lumus_loe_attr_group)) {
+		pr_err("lumus_loe: failed to create attributes!");
+	}
+
+	i2c_set_clientdata(client, data);
+
+	/* now configure the platform data */
+	pdata->ctxt = data;
+	pdata->power_on = lumus_loe_power_on;
+	pdata->power_off = lumus_loe_power_off;
+
+	pr_info("%s", __func__);
+
+	return 0;
+
+exit_free:
+	kfree(data);
+err:
+	return ret;
+}
+
+static int lumus_loe_remove(struct i2c_client *client)
+{
+	struct lumus_loe *data = (struct lumus_loe*) i2c_get_clientdata(client);
+	if (data->asic != NULL) {
+		i2c_unregister_device(data->asic);
+	}
+	if (data->lcos != NULL) {
+		i2c_unregister_device(data->lcos);
+	}
+	sysfs_remove_group(&client->dev.kobj, &lumus_loe_attr_group);
+	return 0;
+}
+
+static const struct i2c_device_id lumus_loe_id[] = {
+	{ "lumus_loe_left", 0 },
+	{ "lumus_loe_right", 1 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, lumus_loe_id);
+
+static struct i2c_driver lumus_loe_driver = {
+	.driver		= {
+		.name	= DRV_NAME,
+		.owner	= THIS_MODULE,
+	},
+	.probe		= lumus_loe_probe,
+	.remove		= lumus_loe_remove,
+	.id_table	= lumus_loe_id,
+};
+
+static int __init lumus_loe_init(void)
+{
+	return i2c_add_driver(&lumus_loe_driver);
+}
+
+static void __exit lumus_loe_exit(void)
+{
+	i2c_del_driver(&lumus_loe_driver);
+}
+
+module_init(lumus_loe_init);
+module_exit(lumus_loe_exit);
+
+MODULE_DESCRIPTION("Lumus LOE driver");
