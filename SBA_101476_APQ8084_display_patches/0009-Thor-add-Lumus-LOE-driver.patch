+		I2C_WRITE_REG(me->asic, 0xD2, 0x00);   // SELP_A
+		I2C_WRITE_REG(me->asic, 0xD3, 0x55);
+		I2C_WRITE_REG(me->asic, 0xD4, 0x1D);   // DC_A = 7509, DCS_A = 0
+
+		I2C_WRITE_REG(me->asic, 0xD5, 0x04);   // SELM_B, PLLB = CLK LCOS = 155 MHz
+		I2C_WRITE_REG(me->asic, 0xD6, 0x00);   // SELP_B
+		I2C_WRITE_REG(me->asic, 0xD7, 0x44);
+		I2C_WRITE_REG(me->asic, 0xD8, 0x0e);   // DC_B = 3652, DCS_B = 0
+
+		I2C_WRITE_REG(me->asic, 0xD9, 0x04);   // SELM_C, PLLC = CLK SCO = 154 MHz
+		I2C_WRITE_REG(me->asic, 0xDA, 0x00);   // SELP_C
+		I2C_WRITE_REG(me->asic, 0xDC, 0x55);
+		I2C_WRITE_REG(me->asic, 0xDD, 0x0d);   // DC_C = 5461, DCS_C =0
+
+		I2C_WRITE_REG(me->asic, 0xDE, 0x00);   // SELP_E, PLLE = CLK SCM  = 166 MHz
+
+		// PLL_SSC
+		I2C_WRITE_REG(me->asic, 0xED, 0x01); // PLLA Normal
+		I2C_WRITE_REG(me->asic, 0xEE, 0x01); // PLLB Normal
+		I2C_WRITE_REG(me->asic, 0xEF, 0x01); // PLLC Normal
+
+		// System
+		I2C_WRITE_REG(me->asic, 0xF1, 0x0d);   // SDRAM PHASE
+		I2C_WRITE_REG(me->asic, 0xF2, 0x0b);   // LCOS PHASE
+		I2C_WRITE_REG(me->asic, 0xF3, 0x01); // Dual Edge
+		I2C_WRITE_REG(me->asic, 0xF7, 0x71); // LVDS input
+		I2C_WRITE_REG(me->asic, 0xF0, 0x11); // Display on, Sys enable
+
+		ret = 0;
+		break;
+
+	default:
+		break;
+	}
+
+	pr_debug("%s: %s", __func__, (0 == ret) ? "success" : "failed");
+
+	return ret;
+}
