From 3171558ab056b39f8b9fae927986055d596dc98d Mon Sep 17 00:00:00 2001
From: Baji Patthan <bpatth@codeaurora.org>
Date: Thu, 29 Oct 2015 16:10:06 -0700
Subject: [PATCH] kernel:msm: nic emmc driver changes

kernel:msm: nic emmc driver changes

Change-Id: I66ee3b195614ac7bb967de91be94b0a56eb17e39
Signen-off-by: Baji Patthan <bpatth@codeaurora.org>
---
 arch/arm/boot/dts/qcom/apq8096-dragonboard.dtsi | 14 ++++++++++++++
 arch/arm64/configs/msm-perf_defconfig           |  2 ++
 arch/arm64/configs/msm_defconfig                |  2 ++
 drivers/video/msm/mdss/mdss_debug.c             |  3 +++
 4 files changed, 21 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/apq8096-dragonboard.dtsi b/arch/arm/boot/dts/qcom/apq8096-dragonboard.dtsi
index 05d183f..023b85d 100644
--- a/arch/arm/boot/dts/qcom/apq8096-dragonboard.dtsi
+++ b/arch/arm/boot/dts/qcom/apq8096-dragonboard.dtsi
@@ -31,6 +31,10 @@
 	status = "ok";
 };
 
+&sdcc1_ice {
+	status = "ok";
+};
+
 &ufsphy1 {
 	status = "ok";
 };
@@ -61,6 +65,7 @@
 
 	qcom,clk-rates = <400000 20000000 25000000 50000000
 				96000000 192000000 384000000>;
+	qcom,ice-clk-rates = <300000000 150000000>;
 	qcom,nonremovable;
 	qcom,bus-speed-mode = "HS400_1p8v", "HS200_1p8v", "DDR_1p8v";
 
@@ -357,6 +362,9 @@
 &labibb {
 	status = "ok";
 	qpnp,qpnp-labibb-mode = "lcd";
+};
+
+&ibb_regulator {
 	qcom,qpnp-ibb-discharge-resistor = <32>;
 };
 
@@ -547,6 +555,10 @@
 			synaptics,irq-gpio = <&tlmm 125 0x2008>;
 			synaptics,button-map = <139 102 158>;
 			synaptics,disable-gpios;
+			/* Underlying clocks used by secure touch */
+			clock-names = "iface_clk", "core_clk";
+			clocks = <&clock_gcc clk_gcc_blsp2_ahb_clk>,
+				 <&clock_gcc clk_gcc_blsp2_qup6_i2c_apps_clk>;
 		};
 	};
 
@@ -687,6 +699,7 @@
 
 	gpio@c700 { /* GPIO 8 - WLAN_EN */
 		qcom,mode = <1>;	/* Digital output*/
+		qcom,out-strength = <2>;/* QPNP_PIN_OUT_STRENGTH_MED */
 		qcom,pull = <4>;	/* Pulldown 10uA */
 		qcom,vin-sel = <2>;	/* VIN2 */
 		qcom,src-sel = <0>;	/* GPIO */
@@ -766,6 +779,7 @@
 
 	gpio@d200 { /* GPIO 19 - Rome BT Reset */
 		qcom,mode = <1>;		/* Digital output*/
+		qcom,out-strength = <2>;	/* QPNP_PIN_OUT_STRENGTH_MED */
 		qcom,pull = <4>;		/* Pulldown 10uA */
 		qcom,vin-sel = <2>;		/* VIN2 */
 		qcom,src-sel = <0>;		/* GPIO */
diff --git a/arch/arm64/configs/msm-perf_defconfig b/arch/arm64/configs/msm-perf_defconfig
index 41eb217..b6cd5e6 100644
--- a/arch/arm64/configs/msm-perf_defconfig
+++ b/arch/arm64/configs/msm-perf_defconfig
@@ -250,6 +250,8 @@ CONFIG_NETDEVICES=y
 CONFIG_BONDING=y
 CONFIG_DUMMY=y
 CONFIG_TUN=y
+CONFIG_E1000=y
+CONFIG_E1000E=y
 CONFIG_RNDIS_IPA=y
 CONFIG_PPP=y
 CONFIG_PPP_BSDCOMP=y
diff --git a/arch/arm64/configs/msm_defconfig b/arch/arm64/configs/msm_defconfig
index 61dc63a..ed5110f 100644
--- a/arch/arm64/configs/msm_defconfig
+++ b/arch/arm64/configs/msm_defconfig
@@ -251,6 +251,8 @@ CONFIG_NETDEVICES=y
 CONFIG_BONDING=y
 CONFIG_DUMMY=y
 CONFIG_TUN=y
+CONFIG_E1000=y
+CONFIG_E1000E=y
 CONFIG_RNDIS_IPA=y
 CONFIG_PPP=y
 CONFIG_PPP_BSDCOMP=y
diff --git a/drivers/video/msm/mdss/mdss_debug.c b/drivers/video/msm/mdss/mdss_debug.c
index b27d12e..3843000 100644
--- a/drivers/video/msm/mdss/mdss_debug.c
+++ b/drivers/video/msm/mdss/mdss_debug.c
@@ -299,6 +299,9 @@ int panel_debug_register_base(const char *name, void __iomem *base,
 		goto reg_fail;
 	}
 
+	/* Initialize list to make sure check for null list will be valid */
+	INIT_LIST_HEAD(&dbg->dump_list);
+
 	list_add(&dbg->head, &mdd->base_list);
 
 	return 0;
-- 
1.8.2.1

