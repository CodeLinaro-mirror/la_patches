+/*==========================================================
+ * FUNCTION   : setHALBufQueueSize
+ *
+ * DESCRIPTION: set HAL buffer queue size from user setting
+ *
+ * PARAMETERS :
+ *   @params  : user setting parameters
+ *
+ * RETURN     : int32_t type of status
+ *              NO_ERROR  -- success
+ *              none-zero failure code
+ *===========================================================*/
+
+int32_t QCameraParameters::setHALBufQueueSize(
+  const QCameraParameters& params)
+{
+    const char *str = params.get(KEY_QC_HAL_BUFFER_QUEUE_SIZE);
+    const char *prev_str = get(KEY_QC_HAL_BUFFER_QUEUE_SIZE);
+    char prop[PROPERTY_VALUE_MAX];
+    memset(prop, 0, sizeof(prop));
+
+    if ((str != NULL) && (prev_str == NULL || strcmp(str, prev_str) != 0)) {
+        ALOGD("%s : HAL bufferq queue size set to KEY: %s", __func__, str);
+        setHALBufQueueSize(str);
+    }
+    return NO_ERROR;
+}
+
 /*===========================================================================
  * FUNCTION   : setZslAttributes
  *
@@ -3861,6 +3891,7 @@ int32_t QCameraParameters::updateParameters(QCameraParameters& params,
     if ((rc = setSnapshotFDReq(params)))                final_rc = rc;
     if ((rc = setTintlessValue(params)))                final_rc = rc;
     if ((rc = setCDSMode(params)))                      final_rc = rc;
+    if ((rc = setHALBufQueueSize(params)))              final_rc = rc;
 
     // update live snapshot size after all other parameters are set
     if ((rc = setLiveSnapshotSize(params)))             final_rc = rc;
@@ -6759,6 +6790,32 @@ int32_t QCameraParameters::setSecureMode(const char *str)
 }
 
 /*===========================================================================
+ * FUNCTION   : setHALBufQueueSize
+ *
+ * DESCRIPTION: set HAL buffer queue size value
+ *
+ * PARAMETERS :
+ *   @str     : HAL buffer queue size value string
+ *
+ * RETURN     : int32_t type of status
+ *              NO_ERROR  -- success
+ *              none-zero failure code
+ *==========================================================================*/
+int32_t QCameraParameters::setHALBufQueueSize(const char *str)
+{
+  ALOGD("%s: HAL buffer queue size value: %s", __func__, str);
+
+  if (str != NULL) {
+    int32_t value = atoi(str);
+    updateParamEntry(KEY_QC_HAL_BUFFER_QUEUE_SIZE, str);
+    m_HALBufQueueSize = value;
+    return NO_ERROR;
+  }
+  ALOGE("%s: HAL buffer queue size is NULL", __func__);
+  return BAD_VALUE;
+}
