 /*===========================================================================
+ * FUNCTION   : matchCamFramesExceptOne
+ *
+ * DESCRIPTION: match function for deleting all camera frames except the one
+ *              passed in (just added)
+ *==========================================================================*/
+bool matchCamFramesExceptOne(void *data, void *, void *match_data) {
+    if (data == match_data) {
+        return false;
+    }
+    if (((qcamera_callback_argm_t *) data)->cb_type != QCAMERA_NOTIFY_CALLBACK) {
+        return true;
+    }
+    return false;
+}
+
+/*===========================================================================
  * FUNCTION   : notifyCallback
  *
  * DESCRIPTION: Enqueus pending callback notifications for the upper layers.
@@ -2147,7 +2163,8 @@ void * QCameraCbNotifier::cbNotifyRoutine(void * data)
  *              NO_ERROR  -- success
  *              none-zero failure code
  *==========================================================================*/
-int32_t QCameraCbNotifier::notifyCallback(qcamera_callback_argm_t &cbArgs)
+int32_t QCameraCbNotifier::notifyCallback(qcamera_callback_argm_t &cbArgs,
+                                          int32_t nHALBufQueueSize)
 {
     if (!mActive) {
         ALOGE("%s: notify thread is not active", __func__);
@@ -2162,6 +2179,18 @@ int32_t QCameraCbNotifier::notifyCallback(qcamera_callback_argm_t &cbArgs)
     memset(cbArg, 0, sizeof(qcamera_callback_argm_t));
     *cbArg = cbArgs;
 
+    // if we get a camera frame, put it at the top of the queue and erase all
+    // other older camera frames
+    if (1 == nHALBufQueueSize && cbArgs.cb_type != QCAMERA_NOTIFY_CALLBACK) {
+        if (!mDataQ.enqueueWithPriority((void *)cbArg)) {
+            ALOGE("%s: Error adding cb data into queue", __func__);
+            delete cbArg;
+            return UNKNOWN_ERROR;
+        }
+        mDataQ.flushNodes(&matchCamFramesExceptOne, cbArg);
+        return mProcTh.sendCmd(CAMERA_CMD_TYPE_DO_NEXT_JOB, FALSE, FALSE);
+    }
+
     if (mDataQ.enqueue((void *)cbArg)) {
         return mProcTh.sendCmd(CAMERA_CMD_TYPE_DO_NEXT_JOB, FALSE, FALSE);
     } else {
