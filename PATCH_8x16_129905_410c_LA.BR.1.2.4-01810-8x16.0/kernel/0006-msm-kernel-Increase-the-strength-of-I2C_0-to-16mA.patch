From e2ef78cdeb248702530e71721ac7d5a9f63ad3e6 Mon Sep 17 00:00:00 2001
From: Baji Patthan <bpatth@codeaurora.org>
Date: Thu, 10 Dec 2015 17:35:09 -0800
Subject: [PATCH] msm/kernel: Increase the strength of I2C_0 to 16mA

msm/kernel: Increase the strength of I2C_0 to 16mA
from 2mA for the I2C sensors

Change-Id: I933707c500f6a8951464b4e050d4bdc04f50a5f9
Signed-off-by: Baji Patthan <bpatth@codeaurora.org>
---
 arch/arm/boot/dts/qcom/msm8916-pinctrl.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/qcom/msm8916-pinctrl.dtsi b/arch/arm/boot/dts/qcom/msm8916-pinctrl.dtsi
index 4de4102..f85e47d7 100644
--- a/arch/arm/boot/dts/qcom/msm8916-pinctrl.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8916-pinctrl.dtsi
@@ -424,12 +424,12 @@
 			label = "pmx_i2c_0";
 
 			i2c_0_active: i2c_0_active {
-				drive-strength = <2>; /* 2 MA */
+				drive-strength = <16>; /* 2 MA */
 				bias-disable;         /* No PULL */
 			};
 
 			i2c_0_sleep: i2c_0_sleep {
-				drive-strength = <2>; /* 2 MA */
+				drive-strength = <16>; /* 2 MA */
 				bias-disable;	      /* No PULL */
 			};
 		};
-- 
1.8.2.1

