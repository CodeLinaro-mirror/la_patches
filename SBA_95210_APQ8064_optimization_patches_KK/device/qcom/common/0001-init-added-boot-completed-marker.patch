From d536fe9206059150b369a1a27843f926b6bb3b69 Mon Sep 17 00:00:00 2001
From: Amarendra Shukla <amaren@codeaurora.org>
Date: Mon, 22 Dec 2014 14:57:16 +0000
Subject: [PATCH 1/2] init: added "boot completed" marker

added timer marker for boot_completed

Change-Id: I4cf1a3c1b844d961a02b30b3131638992a1e0e85
---
 rootdir/etc/init.qcom.rc | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rootdir/etc/init.qcom.rc b/rootdir/etc/init.qcom.rc
index 1047f6e..e204eec 100755
--- a/rootdir/etc/init.qcom.rc
+++ b/rootdir/etc/init.qcom.rc
@@ -586,6 +586,7 @@ service wifi-crda /system/bin/sh /system/etc/init.crda.sh
 
 
 on property:sys.boot_completed=1
+    write /proc/bootkpi/marker_entry "Boot completed"
     start qcom-post-boot
 
 service atfwd /system/bin/ATFWD-daemon
-- 
1.8.2.1

